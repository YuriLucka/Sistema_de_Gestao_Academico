@page
@model ResetPasswordModel
@{
    ViewData["Title"] = "Redefinir senha";
    Layout = "/Views/Shared/_Layout.cshtml";
}

<div class="flex items-center justify-center min-h-[60vh] py-8 px-4">
    <div class="w-full max-w-md">
        <div class="mb-6 text-center">
            <i data-lucide="lock" class="w-12 h-12 text-[#25D366] mb-4"></i>
            <h1 class="text-2xl md:text-3xl font-bold text-gray-900 mb-2">@ViewData["Title"]</h1>
            <p class="text-gray-600 text-base mb-4">Redefina sua senha.</p>
        </div>
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="bg-red-50 border-l-4 border-red-500 text-red-700 p-4 mb-6 rounded-lg animate-pulse" role="alert"></div>
            <input asp-for="Input.Code" type="hidden" />
            <!-- Email -->
            <div class="mb-5">
                <label asp-for="Input.Email" class="block text-sm font-semibold text-gray-700 mb-2">E-mail</label>
                <div class="relative flex items-center">
                    <div class="absolute left-0 pl-4 flex items-center h-full pointer-events-none">
                        <i data-lucide="mail" class="w-5 h-5 text-gray-400"></i>
                    </div>
                    <input asp-for="Input.Email"
                           class="input-focus w-full pl-12 pr-4 py-3.5 border-2 border-gray-200 rounded-xl text-gray-900 placeholder-gray-400 text-base"
                           autocomplete="username"
                           aria-required="true"
                           placeholder="nome@exemplo.com" />
                </div>
                <span asp-validation-for="Input.Email" class="text-red-600 text-sm mt-1 block"></span>
            </div>
            <!-- Password -->
            <div class="mb-5">
                <label asp-for="Input.Password" class="block text-sm font-semibold text-gray-700 mb-2">Nova senha</label>
                <div class="relative flex items-center">
                    <div class="absolute left-0 pl-4 flex items-center h-full pointer-events-none">
                        <i data-lucide="lock" class="w-5 h-5 text-gray-400"></i>
                    </div>
                    <input asp-for="Input.Password"
                           type="password"
                           class="input-focus w-full pl-12 pr-4 py-3.5 border-2 border-gray-200 rounded-xl text-gray-900 placeholder-gray-400 text-base"
                           autocomplete="new-password"
                           aria-required="true"
                           placeholder="Por favor, digite sua nova senha." />
                </div>
                <span asp-validation-for="Input.Password" class="text-red-600 text-sm mt-1 block"></span>
            </div>
            <!-- Confirm Password -->
            <div class="mb-5">
                <label asp-for="Input.ConfirmPassword" class="block text-sm font-semibold text-gray-700 mb-2">Confirme a senha</label>
                <div class="relative flex items-center">
                    <div class="absolute left-0 pl-4 flex items-center h-full pointer-events-none">
                        <i data-lucide="check" class="w-5 h-5 text-gray-400"></i>
                    </div>
                    <input asp-for="Input.ConfirmPassword"
                           type="password"
                           class="input-focus w-full pl-12 pr-4 py-3.5 border-2 border-gray-200 rounded-xl text-gray-900 placeholder-gray-400 text-base"
                           autocomplete="new-password"
                           aria-required="true"
                           placeholder="Por favor, confirme sua senha." />
                </div>
                <span asp-validation-for="Input.ConfirmPassword" class="text-red-600 text-sm mt-1 block"></span>
            </div>
            <button type="submit" class="btn-primary w-full py-4 px-4 rounded-xl text-white font-semibold text-base mb-3 transition-all hover:shadow-lg flex items-center justify-center gap-2">
                <i data-lucide="refresh-ccw" class="w-5 h-5"></i>
                Redefinir
            </button>
            <div class="text-center pt-2">
                <a asp-page="./Login" class="text-gray-600 hover:text-green-600 text-sm font-medium flex items-center justify-center gap-2 transition-colors">
                    <i data-lucide="arrow-left" class="w-4 h-4"></i>
                    Voltar ao login
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>lucide.createIcons();</script>
}

<style>
    .btn-primary {
        background: linear-gradient(135deg, #25D366 0%, #128C7E 100%);
        transition: all 0.3s ease;
    }

        .btn-primary:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 30px rgba(37, 211, 102, 0.3);
        }

    .input-focus {
        transition: all 0.3s ease;
    }

        .input-focus:focus {
            border-color: #25D366;
            box-shadow: 0 0 0 3px rgba(37, 211, 102, 0.1);
            outline: none;
        }
</style>
