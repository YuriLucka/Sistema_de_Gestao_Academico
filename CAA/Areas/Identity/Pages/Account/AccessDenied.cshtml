@page
@model AccessDeniedModel
@{
    ViewData["Title"] = "Acesso negado";
}

<style>
    .access-denied-container {
        min-height: 70vh;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        padding: 2.5rem 1rem;
        background: linear-gradient(135deg, #e9f7ef 0%, #f3f4f6 100%);
        border-radius: 18px;
        box-shadow: 0 8px 32px rgba(37, 211, 102, 0.07);
        margin: 3rem auto 0;
        max-width: 600px;
    }

    .access-denied-img {
        max-width: 260px;
        width: 90%;
        height: auto;
        margin-bottom: 2rem;
        background: white;
        border-radius: 20px;
        box-shadow: 0 10px 36px rgba(18, 140, 126, 0.10);
        padding: 1rem;
    }

    .access-denied-title {
        color: #dc3545;
        font-size: 2.2rem;
        font-weight: 800;
        margin-bottom: 1rem;
        text-shadow: 0 2px 10px rgba(220,53,69,0.05);
        letter-spacing: 1px;
    }

    .access-denied-desc {
        color: #525f68;
        font-size: 1.25rem;
        text-align: center;
        max-width: 440px;
        margin-bottom: 2rem;
    }

    .access-denied-actions {
        margin-top: 1.5rem;
        display: flex;
        gap: 1rem;
        flex-wrap: wrap;
        justify-content: center;
    }

    .access-home-btn {
        background: linear-gradient(135deg, #25d366 0%, #128c7e 100%);
        color: #fff;
        font-weight: 600;
        border-radius: 12px;
        padding: 0.7rem 2.2rem;
        border: none;
        transition: background 0.3s, box-shadow 0.3s, transform 0.15s;
        box-shadow: 0 4px 12px rgba(37, 211, 102, 0.13);
        text-decoration: none;
        display: inline-block;
        font-size: 1.1rem;
    }

        .access-home-btn:hover,
        .access-home-btn:focus {
            background: linear-gradient(135deg, #128c7e 0%, #1da97a 100%);
            transform: translateY(-2px) scale(1.04);
        }
    @@media (max-width: 576px) {
        .access-denied-container

    {
        margin: 2rem 0 0 0;
        padding: 1.25rem 0.25rem;
    }

    .access-denied-img {
        margin-bottom: 1.2rem;
    }

    }
</style>

<div class="access-denied-container">
    <img src="~/img/403error.svg" alt="Acesso negado"
         class="access-denied-img" />

    <div class="access-denied-title">
        <i class="fa fa-ban me-2"></i>Acesso Negado
    </div>
    <p class="access-denied-desc">
        Você não tem permissão para acessar esta página.
    </p>
    <div class="access-denied-actions">
        <a href="~/" class="access-home-btn">
            <i class="fa fa-home me-2"></i>Página inicial
        </a>
    </div>
</div>
