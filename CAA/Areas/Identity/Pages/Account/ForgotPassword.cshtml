@page
@model ForgotPasswordModel
@{
    ViewData["Title"] = "Esqueceu sua senha?";
    Layout = "/Views/Shared/_Layout.cshtml";
}

<div class="mb-8">
    <h1 class="text-3xl font-bold text-gray-900 text-center mb-2">Esqueceu sua senha?</h1>
</div>

<section>
    <form method="post" id="forgot-password-form">
        <div asp-validation-summary="ModelOnly" class="bg-red-50 border-l-4 border-red-500 text-red-700 p-4 mb-6 rounded-lg" role="alert"></div>

        <!-- Email -->
        <div class="mb-6">
            <label asp-for="Input.Email" class="block text-sm font-semibold text-gray-700 mb-2">E-mail</label>
            <div class="relative flex items-center">
                <div class="absolute left-0 pl-4 flex items-center h-full pointer-events-none">
                    <i data-lucide="mail" class="w-5 h-5 text-gray-400"></i>
                </div>
                <input asp-for="Input.Email"
                       class="w-full pl-12 pr-4 py-3.5 border-2 border-gray-200 rounded-xl text-gray-900 placeholder-gray-400 text-base"
                       autocomplete="username"
                       aria-required="true"
                       placeholder="Digite o e-mail da sua conta"
                       id="email-field" />
            </div>
            <span asp-validation-for="Input.Email" class="text-red-600 text-sm mt-1 block"></span>
            <p class="text-sm text-gray-500 mt-2 flex items-start gap-2">
                <i data-lucide="info" class="w-4 h-4 mt-0.5"></i>
                <span>Enviaremos um link de redefinição para este endereço de e-mail</span>
            </p>
        </div>

        <!-- Submit Button -->
        <button type="submit"
                class="btn-primary w-full py-4 px-4 rounded-xl text-white font-semibold text-base mb-6 transition-all hover:shadow-lg"
                id="submit-btn">
            <span class="flex items-center justify-center gap-2">
                <i data-lucide="send" class="w-5 h-5"></i>
                <span id="btn-text">Enviar link de redefinição</span>
            </span>
        </button>

        <!-- Additional Help -->
        <div class="bg-gray-50 rounded-xl p-4 mb-6">
            <div class="flex items-start gap-3">
                <i data-lucide="help-circle" class="w-5 h-5 text-gray-600 mt-0.5"></i>
                <div class="text-sm">
                    <p class="font-semibold text-gray-900 mb-2">Não consegue acessar seu e-mail?</p>
                    <p class="text-gray-600 mb-3">
                        Se você não tem mais acesso ao e-mail cadastrado, entre em contato com nosso suporte.
                    </p>
                    <a href="mailto:suporte@flexcentralpro.com" class="inline-flex items-center gap-2 text-green-600 hover:text-green-700 font-medium transition-colors">
                        <i data-lucide="mail" class="w-4 h-4"></i>
                        Contatar suporte
                    </a>
                </div>
            </div>
        </div>

        <!-- Back to Login -->
        <div class="text-center pt-6 border-t border-gray-200">
            <a asp-page="./Login" class="text-gray-600 hover:text-green-600 text-sm font-medium flex items-center justify-center gap-2 transition-colors">
                <i data-lucide="arrow-left" class="w-4 h-4"></i>
                Voltar ao login
            </a>
        </div>
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Initialize Lucide Icons
        lucide.createIcons();

        // Email validation and enhancement
        const emailField = document.getElementById('email-field');
        const form = document.getElementById('forgot-password-form');
        const submitBtn = document.getElementById('submit-btn');
        const btnText = document.getElementById('btn-text');

        // Email format validation
        function isValidEmail(email) {
            const re = /^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/;
            return re.test(email);
        }

        // Real-time email validation
        emailField.addEventListener('input', function() {
            const email = this.value;
            const validationSpan = this.parentElement.querySelector('.text-red-600');

            if (email && !isValidEmail(email)) {
                if (!validationSpan.textContent) {
                    validationSpan.textContent = 'Por favor, insira um e-mail válido';
                    validationSpan.style.display = 'block';
                }
            } else {
                if (validationSpan && validationSpan.textContent === 'Por favor, insira um e-mail válido') {
                    validationSpan.textContent = '';
                    validationSpan.style.display = 'none';
                }
            }
        });

        // Form submission with loading state
        form.addEventListener('submit', function(e) {
            const email = emailField.value.trim();

            if (!email) {
                e.preventDefault();
                showError('Por favor, preencha o campo de e-mail');
                emailField.focus();
                return;
            }

            if (!isValidEmail(email)) {
                e.preventDefault();
                showError('Por favor, insira um endereço de e-mail válido');
                emailField.focus();
                return;
            }

            // Show loading state
            submitBtn.disabled = true;
            submitBtn.classList.add('opacity-75', 'cursor-not-allowed');
            btnText.textContent = 'Enviando...';

            // Update icon to loading spinner
            const icon = submitBtn.querySelector('i');
            icon.setAttribute('data-lucide', 'loader-2');
            icon.classList.add('animate-spin');
            lucide.createIcons();
        });

        function showError(message) {
            // Remove existing error if present
            const existingError = document.querySelector('.custom-error-message');
            if (existingError) {
                existingError.remove();
            }

            const errorDiv = document.createElement('div');
            errorDiv.className = 'custom-error-message bg-red-50 border-l-4 border-red-500 text-red-700 p-4 mb-6 rounded-lg animate-shake';
            errorDiv.innerHTML = `
                <div class="flex items-center gap-2">
                    <i data-lucide="alert-circle" class="w-5 h-5"></i>
                    <span class="font-medium">${message}</span>
                </div>
            `;

            form.insertBefore(errorDiv, form.firstChild);
            lucide.createIcons();

            // Scroll to error
            errorDiv.scrollIntoView({ behavior: 'smooth', block: 'center' });

            // Remove after 5 seconds
            setTimeout(() => {
                errorDiv.remove();
            }, 5000);
        }

        // Auto-focus on email field
        window.addEventListener('load', function() {
            setTimeout(() => {
                emailField.focus();
            }, 300);
        });
    </script>
}

<style>
    .input-focus {
        transition: all 0.3s ease;
    }

        .input-focus:focus {
            border-color: #25D366;
            box-shadow: 0 0 0 3px rgba(37, 211, 102, 0.1);
            outline: none;
        }

    .btn-primary {
        background: linear-gradient(135deg, #25D366 0%, #128C7E 100%);
        transition: all 0.3s ease;
    }

        .btn-primary:hover:not(:disabled) {
            transform: translateY(-2px);
            box-shadow: 0 10px 30px rgba(37, 211, 102, 0.3);
        }

        .btn-primary:disabled {
            cursor: not-allowed;
        }

    /* Shake animation for errors */
    @@keyframes shake {
        0%, 100% {
            transform: translateX(0);
        }

        10%, 30%, 50%, 70%, 90% {
            transform: translateX(-5px);
        }

        20%, 40%, 60%, 80% {
            transform: translateX(5px);
        }
    }

    .animate-shake {
        animation: shake 0.5s ease;
    }

    /* Loading spinner animation */
    .animate-spin {
        animation: spin 1s linear infinite;
    }

    @@keyframes spin {
        from {
            transform: rotate(0deg);
        }

        to {
            transform: rotate(360deg);
        }
    }

    /* Smooth transitions */
    * {
        transition-property: color, background-color, border-color, transform, opacity;
        transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);
        transition-duration: 150ms;
    }
</style>
