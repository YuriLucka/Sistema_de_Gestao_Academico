@page
@model PersonalDataModel
@{
    ViewData["Title"] = "Gerencie sua conta";
    ViewData["ActivePage"] = ManageNavPages.PersonalData;
}

<h3>Dados pessoais</h3>

<div class="row">
    <div class="col-md-6">
        <p>Sua conta contém dados pessoais que você nos forneceu. Esta página permite que você baixe ou exclua esses dados.</p>
        <p>
            <strong>Excluir esses dados removerá permanentemente sua conta, e isso não poderá ser recuperado.</strong>
        </p>
        <div class="d-flex gap-2">
            <form id="download-data" asp-page="DownloadPersonalData" method="post" class="m-0">
                <button class="btn btn-primary" type="submit">Baixar</button>
            </form>
            <a id="delete" asp-page="DeletePersonalData" class="btn btn-danger">Excluir</a>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
