@page
@model EnableAuthenticatorModel
@{
    ViewData["Title"] = "Configurar aplicativo autenticador";
    ViewData["ActivePage"] = ManageNavPages.TwoFactorAuthentication;
}

<div class="card-body p-4">
    <div class="row">
        <div class="col-md-6">
            <h1 class="display-6 fw-bold text-caa text-center mb-4">@ViewData["Title"]</h1>
            <partial name="_StatusMessage" for="StatusMessage" />
            <p class="mb-3">Para usar um aplicativo autenticador, siga os passos abaixo:</p>
            <ol class="list mb-4">
                <li class="mb-3">
                    <p>
                        Baixe um aplicativo autenticador de dois fatores, como Microsoft Authenticator para
                        <a href="https://go.microsoft.com/fwlink/?Linkid=825072">Android</a> e
                        <a href="https://go.microsoft.com/fwlink/?Linkid=825073">iOS</a> ou
                        Google Authenticator para
                        <a href="https://play.google.com/store/apps/details?id=com.google.android.apps.authenticator2&amp;hl=en">Android</a> e
                        <a href="https://itunes.apple.com/us/app/google-authenticator/id388497605?mt=8">iOS</a>.
                    </p>
                </li>
                <li class="mb-3">
                    <p>Escaneie o código QR ou insira esta chave <kbd>@Model.SharedKey</kbd> no seu aplicativo autenticador de dois fatores. Espaços e maiúsculas/minúsculas não importam.</p>
                    <div id="qrCode" class="mb-3"></div>
                    <div id="qrCodeData" data-url="@Model.AuthenticatorUri"></div>
                </li>
                <li>
                    <p>
                        Após escanear o código QR ou inserir a chave acima, seu aplicativo de autenticação em dois fatores fornecerá
                        um código único. Digite o código na caixa de confirmação abaixo.
                    </p>
                    <form id="send-code" method="post">
                        <div class="form-floating mb-3">
                            <input asp-for="Input.Code" class="form-control" autocomplete="off" placeholder="Por favor, digite o código."/>
                            <label asp-for="Input.Code" class="control-label form-label">Código de verificação</label>
                            <span asp-validation-for="Input.Code" class="text-danger"></span>
                        </div>
                        <button type="submit" class="w-100 btn btn-caa mb-2">Verificar</button>
                        <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
                    </form>
                </li>
            </ol>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script type="text/javascript" src="~/lib/qrcode/qrcode.js"></script>
    <script type="text/javascript" src="~/js/qr.js"></script>
}
