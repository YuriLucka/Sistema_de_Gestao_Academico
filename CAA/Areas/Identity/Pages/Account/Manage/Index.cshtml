@page
@model IndexModel
@{
    ViewData["Title"] = "Gerencie sua conta";
    ViewData["ActivePage"] = ManageNavPages.Index;
}

<partial name="_StatusMessage" for="StatusMessage" />
<div class="row">
    <div class="col-md-6">
        <form id="profile-form" method="post" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
            <div class="d-flex flex-column align-items-center mb-3">
                <label asp-for="Input.FotoPerfil" class="form-label">Foto de Perfil</label>
                <div class="mb-2">
                    <img id="imgPreview" src="@Model.FotoPerfilUrl" class="rounded-circle border shadow-sm" style="width: 120px; height: 120px; object-fit: cover;" alt="Pré-visualização da foto" />
                </div>
                <div class="input-group custom-file-group w-100 mb-2" style="max-width: 300px;">
                    <input asp-for="Input.FotoPerfil" class="form-control d-none" type="file" accept="image/*" id="fotoPerfilInput" onchange="previewImage(event)" />
                    <button type="button" class="btn btn-caa w-100 d-flex align-items-center justify-content-center gap-2" onclick="document.getElementById('fotoPerfilInput').click();">
                        <i class="bi bi-upload"></i> <span id="fileLabel">Selecionar imagem</span>
                    </button>
                </div>
                <span asp-validation-for="Input.FotoPerfil" class="text-danger"></span>
            </div>
            <div class="form-floating mb-3">
                <input asp-for="Username" class="form-control" placeholder="Por favor, escolha seu nome de usuário." disabled />
                <label asp-for="Username" class="form-label"></label>
            </div>
            <div class="form-floating mb-3">
                <input asp-for="Input.PhoneNumber" class="form-control" placeholder="Por favor, digite seu número de telefone."/>
                <label asp-for="Input.PhoneNumber" class="form-label"></label>
                <span asp-validation-for="Input.PhoneNumber" class="text-danger"></span>
            </div>
            <button id="update-profile-button" type="submit" class="w-100 btn btn-caa btn-lg">Salvar</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function previewImage(event) {
            const input = event.target;
            const preview = document.getElementById('imgPreview');
            const fileLabel = document.getElementById('fileLabel');
            if (input.files && input.files[0]) {
                const reader = new FileReader();
                reader.onload = function (e) {
                    preview.src = e.target.result;
                };
                reader.readAsDataURL(input.files[0]);
                fileLabel.textContent = input.files[0].name;
            } else {
                preview.src = '@Model.FotoPerfilUrl';
                fileLabel.textContent = 'Selecionar imagem';
            }
        }
    </script>
}
