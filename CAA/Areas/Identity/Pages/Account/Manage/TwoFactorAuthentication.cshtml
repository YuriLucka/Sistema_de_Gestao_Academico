@page
@using Microsoft.AspNetCore.Http.Features
@model TwoFactorAuthenticationModel
@{
    ViewData["Title"] = "Autenticação em dois fatores (2FA)";
    ViewData["ActivePage"] = ManageNavPages.TwoFactorAuthentication;
}

<div class="card-body p-4">
    <div class="row">
        <div class="col-md-6">
            <h1 class="display-6 fw-bold text-caa text-center mb-4">@ViewData["Title"]</h1>
            <partial name="_StatusMessage" for="StatusMessage" />
            @{
                var consentFeature = HttpContext.Features.Get<ITrackingConsentFeature>();
                if (consentFeature?.CanTrack ?? true)
                {
                    if (Model.Is2faEnabled)
                    {
                        if (Model.RecoveryCodesLeft == 0)
                        {
                            <div class="alert alert-danger text-center">
                                <strong>Você não possui códigos de recuperação restantes.</strong>
                                <p>Você deve <a asp-page="./GenerateRecoveryCodes">gerar um novo conjunto de códigos de recuperação</a> antes de poder entrar com um código de recuperação.</p>
                            </div>
                        }
                        else if (Model.RecoveryCodesLeft == 1)
                        {
                            <div class="alert alert-danger text-center">
                                <strong>Você possui 1 código de recuperação restante.</strong>
                                <p>Você pode <a asp-page="./GenerateRecoveryCodes">gerar um novo conjunto de códigos de recuperação</a>.</p>
                            </div>
                        }
                        else if (Model.RecoveryCodesLeft <= 3)
                        {
                            <div class="alert alert-warning text-center">
                                <strong>Você possui @Model.RecoveryCodesLeft códigos de recuperação restantes.</strong>
                                <p>Você deve <a asp-page="./GenerateRecoveryCodes">gerar um novo conjunto de códigos de recuperação</a>.</p>
                            </div>
                        }

                        <div class="d-flex flex-wrap gap-2 justify-content-center mb-3">
                            @if (Model.IsMachineRemembered)
                            {
                                <form method="post" style="display: inline-block">
                                    <button type="submit" class="btn btn-outline-primary">Esquecer este navegador</button>
                                </form>
                            }
                            <a asp-page="./Disable2fa" class="btn btn-outline-danger">Desativar 2FA</a>
                            <a asp-page="./GenerateRecoveryCodes" class="btn btn-outline-primary">Redefinir códigos de recuperação</a>
                        </div>
                    }

                    <h4 class="fw-bold text-center mt-4 mb-3">Aplicativo autenticador</h4>
                    <div class="d-flex flex-wrap gap-2 justify-content-center">
                        @if (!Model.HasAuthenticator)
                        {
                            <a id="enable-authenticator" asp-page="./EnableAuthenticator" class="btn btn-caa">Adicionar aplicativo autenticador</a>
                        }
                        else
                        {
                            <a id="enable-authenticator" asp-page="./EnableAuthenticator" class="btn btn-caa">Configurar aplicativo autenticador</a>
                            <a id="reset-authenticator" asp-page="./ResetAuthenticator" class="btn btn-outline-warning">Redefinir aplicativo autenticador</a>
                        }
                    </div>
                }
                else
                {
                    <div class="alert alert-danger text-center">
                        <strong>A política de privacidade e cookies não foi aceita.</strong>
                        <p>Você deve aceitar a política antes de poder habilitar a autenticação em dois fatores.</p>
                    </div>
                }
            }
        </div>
    </div>
</div>



@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
