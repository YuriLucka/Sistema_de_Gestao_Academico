@page
@model ResetAuthenticatorModel
@{
    ViewData["Title"] = "Redefinir chave do autenticador";
    ViewData["ActivePage"] = ManageNavPages.TwoFactorAuthentication;
}

<div class="card-body p-4">
    <div class="row">
        <div class="col-md-8 col-lg-7">
            <h1 class="display-6 fw-bold text-caa text-center mb-4">@ViewData["Title"]</h1>
            <partial name="_StatusMessage" for="StatusMessage" />
            <div class="alert alert-warning text-center mb-4" role="alert">
                <p class="mb-2">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>
                    <strong>Se você redefinir sua chave do autenticador, seu aplicativo autenticador não funcionará até que você o reconfigure.</strong>
                </p>
                <p>
                    Este processo desativa a autenticação em dois fatores (2FA) até que você verifique seu aplicativo autenticador.<br />
                    Se você não concluir a configuração do aplicativo autenticador, poderá perder o acesso à sua conta.
                </p>
            </div>
            <form id="reset-authenticator-form" method="post">
                <button id="reset-authenticator-button" class="btn btn-danger w-100" type="submit">Redefinir chave do autenticador</button>
            </form>
        </div>
    </div>
</div>
