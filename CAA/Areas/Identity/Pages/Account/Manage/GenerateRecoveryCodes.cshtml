@page
@model GenerateRecoveryCodesModel
@{
    ViewData["Title"] = "Gerar códigos de recuperação para autenticação em dois fatores (2FA)";
    ViewData["ActivePage"] = ManageNavPages.TwoFactorAuthentication;
}

<div class="card-body p-4">
    <div class="row">
        <div class="col-md-8 col-lg-7">
            <h1 class="display-6 fw-bold text-caa text-center mb-4">@ViewData["Title"]</h1>
            <partial name="_StatusMessage" for="StatusMessage" />
            <div class="alert alert-warning text-center mb-4" role="alert">
                <p class="mb-2">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>
                    <strong>Guarde estes códigos em um local seguro.</strong>
                </p>
                <p>
                    Se você perder seu dispositivo e não tiver os códigos de recuperação, perderá o acesso à sua conta.
                </p>
                <p>
                    Gerar novos códigos de recuperação não altera as chaves usadas nos aplicativos autenticadores. Se desejar alterar a chave
                    usada em um aplicativo autenticador, você deve <a asp-page="./ResetAuthenticator">redefinir suas chaves do autenticador.</a>
                </p>
            </div>
            <form method="post">
                <button class="btn btn-danger w-100" type="submit">Gerar códigos de recuperação</button>
            </form>
        </div>
    </div>
</div>
