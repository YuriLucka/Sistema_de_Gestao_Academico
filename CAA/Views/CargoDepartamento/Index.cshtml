@model IEnumerable<CAA.Models.CargoDepartamento>

@{
    ViewData["Title"] = "Cargo Departamento";
}

<style>

    /* Page Header */
    .cargo-dept-page-header {
        background: linear-gradient(135deg, rgba(37, 211, 102, 0.05) 0%, rgba(18, 140, 126, 0.05) 100%);
        border-radius: 16px;
        padding: 2rem;
        margin-bottom: 2rem;
        border: 1px solid rgba(37, 211, 102, 0.2);
        backdrop-filter: blur(10px);
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 1rem;
    }

    .cargo-dept-header-content h1 {
        font-size: 1.75rem;
        font-weight: 700;
        color: var(--caa-green-dark);
        margin-bottom: 0.5rem;
        display: flex;
        align-items: center;
        gap: 0.75rem;
    }

        .cargo-dept-header-content h1 i {
            font-size: 2rem;
        }

    .cargo-dept-header-content p {
        color: #6b7280;
        margin: 0;
        font-size: 0.95rem;
    }

    .btn-new-vinculo {
        background: linear-gradient(135deg, var(--caa-green-main), var(--caa-green-dark));
        color: white;
        border: none;
        border-radius: 12px;
        padding: 0.875rem 1.75rem;
        font-weight: 600;
        font-size: 0.95rem;
        transition: all 0.3s ease;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        text-decoration: none;
        box-shadow: 0 4px 15px rgba(37, 211, 102, 0.2);
    }

        .btn-new-vinculo:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(37, 211, 102, 0.35);
            color: white;
        }

    /* List Container */
    .vinculos-list-container {
        background: white;
        border-radius: 20px;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
        overflow: hidden;
        border: 2px solid #f3f4f6;
    }

    .vinculos-list {
        list-style: none;
        padding: 0;
        margin: 0;
    }

    .vinculo-item {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 1.5rem 2rem;
        border-bottom: 1px solid #f3f4f6;
        transition: all 0.3s ease;
        gap: 1.5rem;
    }

        .vinculo-item:last-child {
            border-bottom: none;
        }

        .vinculo-item:hover {
            background: var(--caa-green-light);
        }

    .vinculo-content {
        display: flex;
        align-items: center;
        gap: 1.5rem;
        flex: 1;
        min-width: 0;
    }

    .vinculo-cargo {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        flex: 1;
        min-width: 0;
    }

    .cargo-badge {
        width: 48px;
        height: 48px;
        background: rgba(147, 51, 234, 0.1);
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

        .cargo-badge i {
            font-size: 1.5rem;
            color: #9333ea;
        }

    .cargo-info {
        flex: 1;
        min-width: 0;
    }

    .cargo-name {
        font-size: 1rem;
        font-weight: 600;
        color: #111b21;
        margin: 0;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .cargo-label {
        font-size: 0.75rem;
        color: #6b7280;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        font-weight: 600;
    }

    .vinculo-arrow {
        color: #d1d7db;
        font-size: 1.5rem;
        flex-shrink: 0;
    }

    .vinculo-departamento {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        flex: 1;
        min-width: 0;
    }

    .dept-badge {
        width: 48px;
        height: 48px;
        background: var(--caa-green-light);
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

        .dept-badge i {
            font-size: 1.5rem;
            color: var(--caa-green-main);
        }

    .dept-info {
        flex: 1;
        min-width: 0;
    }

    .dept-name {
        font-size: 1rem;
        font-weight: 600;
        color: #111b21;
        margin: 0;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .dept-label {
        font-size: 0.75rem;
        color: #6b7280;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        font-weight: 600;
    }

    .vinculo-actions {
        display: flex;
        gap: 0.5rem;
        flex-shrink: 0;
    }

    .btn-action {
        padding: 0.5rem 0.875rem;
        border-radius: 10px;
        border: none;
        font-size: 0.85rem;
        font-weight: 600;
        transition: all 0.3s ease;
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        text-decoration: none;
        cursor: pointer;
    }

    .btn-edit {
        background: rgba(37, 211, 102, 0.1);
        color: var(--caa-green-main);
    }

        .btn-edit:hover {
            background: var(--caa-green-main);
            color: white;
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(37, 211, 102, 0.3);
        }

    .btn-details {
        background: rgba(59, 130, 246, 0.1);
        color: #3b82f6;
    }

        .btn-details:hover {
            background: #3b82f6;
            color: white;
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(59, 130, 246, 0.3);
        }

    .btn-delete {
        background: rgba(239, 68, 68, 0.1);
        color: #ef4444;
    }

        .btn-delete:hover {
            background: #ef4444;
            color: white;
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(239, 68, 68, 0.3);
        }

    /* Empty State */
    .empty-state {
        text-align: center;
        padding: 5rem 2rem;
        color: #6b7280;
    }

        .empty-state i {
            font-size: 5rem;
            color: #d1d7db;
            margin-bottom: 1.5rem;
        }

        .empty-state h3 {
            color: #374151;
            margin-bottom: 0.75rem;
            font-size: 1.5rem;
            font-weight: 700;
        }

        .empty-state p {
            color: #9ca3af;
            font-size: 1rem;
            margin-bottom: 1.5rem;
        }

    /* Responsive */
    @@media (max-width: 992px) {
        .vinculo-content

    {
        flex-direction: column;
        align-items: stretch;
    }

    .vinculo-arrow {
        transform: rotate(90deg);
        align-self: center;
    }

    .vinculo-cargo,
    .vinculo-departamento {
        width: 100%;
    }

    }

    @@media (max-width: 768px) {
        .cargo-dept-page-header

    {
        flex-direction: column;
        align-items: stretch;
        text-align: center;
    }

    .cargo-dept-header-content h1 {
        justify-content: center;
    }

    .btn-new-vinculo {
        width: 100%;
        justify-content: center;
    }

    .vinculo-item {
        flex-direction: column;
        align-items: stretch;
        gap: 1rem;
    }

    .vinculo-actions {
        justify-content: center;
        flex-wrap: wrap;
    }

    .btn-action {
        flex: 1;
        min-width: 100px;
        justify-content: center;
    }

    }
</style>

<div class="container-fluid px-3">
    <!-- Page Header -->
    <div class="cargo-dept-page-header">
        <div class="cargo-dept-header-content">
            <h1>
                <i class="bi bi-link-45deg"></i>
                <span>Cargo Departamento</span>
            </h1>
            <p>Gerencie os vínculos entre cargos e departamentos</p>
        </div>
        <a asp-action="Create" class="btn-new-vinculo">
            <i class="bi bi-plus-circle"></i>
            <span>Novo Vínculo</span>
        </a>
    </div>

    <!-- Vínculos List -->
    <div class="vinculos-list-container">
        @if (Model != null && Model.Any())
        {
            <ul class="vinculos-list">
                @foreach (var vinculo in Model)
                {
                    <li class="vinculo-item">
                        <div class="vinculo-content">
                            <!-- Cargo -->
                            <div class="vinculo-cargo">
                                <div class="cargo-badge">
                                    <i class="bi bi-briefcase-fill"></i>
                                </div>
                                <div class="cargo-info">
                                    <div class="cargo-label">Cargo</div>
                                    <h3 class="cargo-name">@Html.DisplayFor(modelItem => vinculo.Cargo.Nome)</h3>
                                </div>
                            </div>

                            <!-- Arrow -->
                            <div class="vinculo-arrow">
                                <i class="bi bi-arrow-right-circle"></i>
                            </div>

                            <!-- Departamento -->
                            <div class="vinculo-departamento">
                                <div class="dept-badge">
                                    <i class="bi bi-people-fill"></i>
                                </div>
                                <div class="dept-info">
                                    <div class="dept-label">Departamento</div>
                                    <h3 class="dept-name">@Html.DisplayFor(modelItem => vinculo.Departamento.Nome)</h3>
                                </div>
                            </div>
                        </div>

                        <!-- Actions -->
                        <div class="vinculo-actions">
                            <a asp-action="Edit" asp-route-id="@vinculo.CargoDepartamentoId" class="btn-action btn-edit" title="Editar">
                                <i class="bi bi-pencil"></i>
                                <span>Editar</span>
                            </a>
                            <a asp-action="Details" asp-route-id="@vinculo.CargoDepartamentoId" class="btn-action btn-details" title="Detalhes">
                                <i class="bi bi-eye"></i>
                                <span>Ver</span>
                            </a>
                            <a asp-action="Delete" asp-route-id="@vinculo.CargoDepartamentoId" class="btn-action btn-delete" title="Excluir">
                                <i class="bi bi-trash"></i>
                                <span>Excluir</span>
                            </a>
                        </div>
                    </li>
                }
            </ul>
        }
        else
        {
            <div class="empty-state">
                <i class="bi bi-link-45deg"></i>
                <h3>Nenhum vínculo cadastrado</h3>
                <p>Vincule cargos aos departamentos</p>
                <a asp-action="Create" class="btn-new-vinculo">
                    <i class="bi bi-plus-circle"></i>
                    <span>Criar Primeiro Vínculo</span>
                </a>
            </div>
        }
    </div>
</div>
