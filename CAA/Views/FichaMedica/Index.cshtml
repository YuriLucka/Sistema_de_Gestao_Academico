@model IEnumerable<CAA.Models.FichaMedica>

@{
    ViewData["Title"] = "Fichas Médicas";
    var fichaUrl = Url.Action("FichaAluno", "FichaMedica", null, Context.Request.Scheme);
}

<style>
    :root {
        --medical-green: #10b981;
        --medical-green-dark: #059669;
        --medical-green-light: rgba(16, 185, 129, 0.1);
        --medical-blue: #3b82f6;
        --medical-red: #ef4444;
    }

    /* Page Header */
    .medical-page-header {
        background: linear-gradient(135deg, rgba(16, 185, 129, 0.05) 0%, rgba(5, 150, 105, 0.05) 100%);
        border-radius: 16px;
        padding: 2rem;
        margin-bottom: 2rem;
        border: 1px solid rgba(16, 185, 129, 0.2);
        backdrop-filter: blur(10px);
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 1rem;
    }

    .medical-header-content h1 {
        font-size: 1.75rem;
        font-weight: 700;
        color: var(--medical-green-dark);
        margin-bottom: 0.5rem;
        display: flex;
        align-items: center;
        gap: 0.75rem;
    }

        .medical-header-content h1 i {
            font-size: 2rem;
        }

    .medical-header-content p {
        color: #6b7280;
        margin: 0;
        font-size: 0.95rem;
    }

    .medical-header-actions {
        display: flex;
        gap: 1rem;
        flex-wrap: wrap;
    }

    /* Buttons with Circle Grow Hover Effect */
    .btn-medical-primary,
    .btn-medical-secondary {
        border: none;
        border-radius: 16px;
        padding: 1rem 2rem;
        font-weight: 600;
        font-size: 1rem;
        transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        position: relative;
        overflow: hidden;
        text-decoration: none;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
        cursor: pointer;
        color: white;
    }

    .btn-medical-primary {
        background: linear-gradient(135deg, var(--medical-green), var(--medical-green-dark));
        box-shadow: 0 4px 15px rgba(16, 185, 129, 0.2);
    }

    .btn-medical-secondary {
        background: linear-gradient(135deg, var(--medical-blue), #2563eb);
        box-shadow: 0 4px 15px rgba(59, 130, 246, 0.2);
    }

        .btn-medical-primary::before,
        .btn-medical-secondary::before {
            content: '';
            position: absolute;
            top: 50%;
            left: 50%;
            width: 0;
            height: 0;
            border-radius: 50%;
            background: rgba(255, 255, 255, 0.3);
            transform: translate(-50%, -50%);
            transition: width 0.6s ease, height 0.6s ease;
            z-index: 0;
        }

        .btn-medical-primary:hover::before,
        .btn-medical-secondary:hover::before {
            width: 300px;
            height: 300px;
        }

        .btn-medical-primary:hover,
        .btn-medical-secondary:hover {
            transform: translateY(-3px);
            box-shadow: 0 8px 25px rgba(16, 185, 129, 0.35);
            color: white;
            z-index: 1;
        }

        .btn-medical-primary i,
        .btn-medical-primary span,
        .btn-medical-secondary i,
        .btn-medical-secondary span {
            position: relative;
            z-index: 1;
        }

    /* Table Container */
    .table-container-medical {
        border-radius: 20px;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
        overflow: hidden;
        padding: 2rem;
        background: white;
    }

    /* DataTables Custom Styling */
    .dataTables_wrapper {
        padding: 0 !important;
    }

    .dataTables_length,
    .dataTables_filter {
        margin-bottom: 1.5rem;
    }

        .dataTables_length label,
        .dataTables_filter label {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            font-weight: 600;
            color: var(--medical-green-dark);
        }

        .dataTables_length select,
        .dataTables_filter input {
            border: 2px solid #e5e7eb;
            border-radius: 10px;
            padding: 0.5rem 0.75rem;
            transition: all 0.3s ease;
            font-size: 0.95rem;
        }

            .dataTables_length select:focus,
            .dataTables_filter input:focus {
                border-color: var(--medical-green);
                box-shadow: 0 0 0 3px var(--medical-green-light);
                outline: none;
            }

    table.dataTable {
        border-collapse: separate !important;
        border-spacing: 0 0.5rem !important;
        width: 100% !important;
    }

        table.dataTable thead th {
            background: linear-gradient(135deg, var(--medical-green-light) 0%, rgba(5, 150, 105, 0.05) 100%);
            color: var(--medical-green-dark);
            font-weight: 700;
            padding: 1rem 1.5rem;
            border: none;
            font-size: 0.9rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

            table.dataTable thead th:first-child {
                border-radius: 12px 0 0 12px;
            }

            table.dataTable thead th:last-child {
                border-radius: 0 12px 12px 0;
            }

        table.dataTable tbody tr {
            background: white;
            transition: all 0.3s ease;
        }

            table.dataTable tbody tr:hover {
                background: var(--medical-green-light);
                transform: scale(1.01);
                box-shadow: 0 4px 12px rgba(16, 185, 129, 0.15);
            }

        table.dataTable tbody td {
            padding: 1.25rem 1.5rem;
            border: none;
            vertical-align: middle;
            font-size: 0.95rem;
            color: #374151;
        }

        table.dataTable tbody tr td:first-child {
            border-radius: 12px 0 0 12px;
            font-weight: 600;
            color: var(--medical-green-dark);
        }

        table.dataTable tbody tr td:last-child {
            border-radius: 0 12px 12px 0;
        }

    /* Action Buttons in Table */
    .btn-action-table {
        padding: 0.5rem 0.75rem;
        border-radius: 10px;
        border: none;
        font-size: 1rem;
        font-weight: 600;
        transition: all 0.3s ease;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        text-decoration: none;
        cursor: pointer;
        min-width: 38px;
        height: 38px;
    }

    .btn-edit-table {
        background: linear-gradient(135deg, #fbbf24 0%, #f59e0b 100%);
        color: white;
    }

        .btn-edit-table:hover {
            background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
            transform: translateY(-2px) scale(1.1);
            box-shadow: 0 6px 20px rgba(251, 191, 36, 0.4);
        }

    .btn-details-table {
        background: linear-gradient(135deg, #3b82f6 0%, #1e40af 100%);
        color: white;
    }

        .btn-details-table:hover {
            background: linear-gradient(135deg, #2563eb 0%, #1e3a8a 100%);
            transform: translateY(-2px) scale(1.1);
            box-shadow: 0 6px 20px rgba(59, 130, 246, 0.4);
        }

    .btn-delete-table {
        background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%);
        color: white;
    }

        .btn-delete-table:hover {
            background: linear-gradient(135deg, #dc2626 0%, #b91c1c 100%);
            transform: translateY(-2px) scale(1.1);
            box-shadow: 0 6px 20px rgba(239, 68, 68, 0.4);
        }

    /* DataTables Info and Pagination */
    .dataTables_info {
        color: #6b7280;
        font-weight: 500;
        padding-top: 1.5rem;
    }

    .dataTables_paginate {
        padding-top: 1.5rem;
    }

        .dataTables_paginate .paginate_button {
            border-radius: 8px;
            padding: 0.5rem 1rem;
            margin: 0 0.25rem;
            border: 2px solid #e5e7eb;
            background: white;
            color: #374151;
            font-weight: 600;
            transition: all 0.3s ease;
        }

            .dataTables_paginate .paginate_button:hover {
                background: var(--medical-green-light);
                border-color: var(--medical-green);
                color: var(--medical-green-dark);
            }

            .dataTables_paginate .paginate_button.current {
                background: var(--medical-green);
                border-color: var(--medical-green);
                color: white;
            }

            .dataTables_paginate .paginate_button.disabled {
                opacity: 0.5;
                cursor: not-allowed;
            }

    /* Modal Styling */
    .modal-content {
        border-radius: 20px;
        border: none;
        box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
        overflow: hidden;
    }

    .modal-header {
        background: linear-gradient(135deg, var(--medical-green), var(--medical-green-dark));
        color: white;
        border-radius: 20px 20px 0 0;
        padding: 1.5rem 2rem;
        border: none;
    }

    .modal-title {
        font-weight: 700;
        font-size: 1.3rem;
    }

    .btn-close {
        filter: brightness(0) invert(1);
        opacity: 0.8;
    }

        .btn-close:hover {
            opacity: 1;
        }

    .modal-body {
        padding: 3rem 2rem;
    }

    .qr-container {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 1.5rem;
    }

    #qrcode {
        padding: 1rem;
        background: white;
        border-radius: 16px;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.1);
        border: 3px solid var(--medical-green-light);
    }

    .qr-url-box {
        background: var(--medical-green-light);
        border: 2px solid var(--medical-green);
        border-radius: 12px;
        padding: 1rem 1.5rem;
        width: 100%;
        max-width: 500px;
        word-break: break-all;
        text-align: center;
    }

        .qr-url-box strong {
            color: var(--medical-green-dark);
            font-size: 0.9rem;
        }

    .modal-backdrop.show {
        opacity: 0.75 !important;
    }

    /* Responsive */
    @@media (max-width: 768px) {
        .medical-page-header {
            flex-direction: column;
            align-items: stretch;
            text-align: center;
            padding: 1.5rem;
        }

        .medical-header-content h1 {
            justify-content: center;
        }

        .medical-header-actions {
            flex-direction: column;
            width: 100%;
        }

        .btn-medical-primary,
        .btn-medical-secondary {
            width: 100%;
            justify-content: center;
        }

        .table-container-medical {
            padding: 1rem;
        }
        /* DataTables Controls - Full Width Stacking */
        .dataTables_wrapper .dataTables_filter,
        .dataTables_wrapper .dataTables_length {
            text-align: left !important;
            float: none !important;
            margin-bottom: 1rem;
            width: 100%;
        }
            /* Força label a ser flex vertical para que o input fique embaixo do texto */
            .dataTables_wrapper .dataTables_length label,
            .dataTables_wrapper .dataTables_filter label {
                display: flex;
                flex-direction: column;
                align-items: flex-start;
                width: 100%;
                gap: 0.5rem;
            }
            /* Inputs ocupando 100% */
            .dataTables_wrapper .dataTables_length select,
            .dataTables_wrapper .dataTables_filter input {
                width: 100% !important;
                margin-left: 0 !important;
                display: block;
                font-size: 1rem; /* Melhor para toque */
                padding: 0.75rem;
            }

        table.dataTable tbody td {
            font-size: 0.85rem;
            padding: 1rem 0.75rem;
        }
    }

    /* Esconde a tabela até o DataTable estar pronto */
    .table-invisible {
        visibility: hidden;
    }
</style>

<div class="container-fluid px-3">
    <!-- Page Header -->
    <div class="medical-page-header">
        <div class="medical-header-content">
            <h1>
                <i class="bi bi-heart-pulse"></i>
                <span>Fichas Médicas</span>
            </h1>
            <p>Gerencie as fichas médicas dos alunos</p>
        </div>
        <div class="medical-header-actions">
            <a asp-action="Create" class="btn-medical-primary">
                <i class="bi bi-plus-circle"></i>
                <span>Nova Ficha Médica</span>
            </a>
            <button type="button" class="btn-medical-secondary" data-bs-toggle="modal" data-bs-target="#qrModal">
                <i class="bi bi-qr-code"></i>
                <span>Gerar QR Code</span>
            </button>
        </div>
    </div>

    <!-- Table Container -->
    <div class="table-container-medical">
        <!-- ADICIONADO: DIV table-responsive para garantir rolagem horizontal -->
        <div class="table-responsive">
            <table id="fichasMedicas" class="table table-hover align-middle nowrap table-invisible" style="width:100%">
                <thead>
                    <tr>
                        <th>@Html.DisplayNameFor(model => model.NomeCompleto)</th>
                        <th>@Html.DisplayNameFor(model => model.RA)</th>
                        <th>@Html.DisplayNameFor(model => model.DataPreenchimento)</th>
                        <th class="text-center">Ações</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@Html.DisplayFor(modelItem => item.NomeCompleto)</td>
                            <td>@Html.DisplayFor(modelItem => item.RA)</td>
                            <td>@Html.DisplayFor(modelItem => item.DataPreenchimento)</td>
                            <td class="text-center">
                                <a asp-action="Edit" asp-route-id="@item.FichaMedicaId" class="btn-action-table btn-edit-table" title="Editar">
                                    <i class="bi bi-pencil-square"></i>
                                </a>
                                <a asp-action="Details" asp-route-id="@item.FichaMedicaId" class="btn-action-table btn-details-table" title="Detalhes">
                                    <i class="bi bi-eye"></i>
                                </a>
                                <a asp-action="Delete" asp-route-id="@item.FichaMedicaId" class="btn-action-table btn-delete-table" title="Excluir">
                                    <i class="bi bi-trash"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- QR Code Modal -->
<div class="modal fade" id="qrModal" tabindex="-1" aria-labelledby="qrModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header justify-content-center">
                <h5 class="modal-title w-100 text-center" id="qrModalLabel">
                    <i class="bi bi-qr-code me-2"></i>
                    QR Code para Preencher Ficha
                </h5>
                <button type="button" class="btn-close position-absolute end-0 me-3" data-bs-dismiss="modal" aria-label="Fechar"></button>
            </div>
            <div class="modal-body">
                <div class="qr-container">
                    <div id="qrcode"></div>
                    <div class="qr-url-box">
                        <strong>@fichaUrl</strong>
                    </div>
                    <p class="text-muted text-center mb-0">
                        <i class="bi bi-info-circle me-1"></i>
                        Escaneie o QR Code ou acesse o link acima
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>

    <script>
        $(document).ready(function () {
            $('#fichasMedicas').DataTable({
                responsive: true,
                language: {
                    url: '//cdn.datatables.net/plug-ins/1.13.6/i18n/pt-BR.json'
                },
                columnDefs: [
                    { orderable: false, targets: [3] },
                    { className: 'text-center', targets: [3] }
                ],
                order: [[2, 'desc']],
                pageLength: 25,
                dom: '<"row"<"col-sm-12 col-md-6"l><"col-sm-12 col-md-6"f>>rtip',
                initComplete: function () {
                    $('#fichasMedicas').removeClass('table-invisible');
                }
            });
        });

        var fichaUrl = '@fichaUrl';
        var qrModal = document.getElementById('qrModal');

        qrModal.addEventListener('shown.bs.modal', function () {
            var qrDiv = document.getElementById('qrcode');
            qrDiv.innerHTML = '';
            var qr = new QRCode(qrDiv, {
                text: fichaUrl,
                width: 280,
                height: 280,
                colorDark: "#059669",
                colorLight: "#ffffff",
                correctLevel: QRCode.CorrectLevel.H
            });
        });

        qrModal.addEventListener('hidden.bs.modal', function () {
            document.getElementById('qrcode').innerHTML = '';
        });
    </script>
}
