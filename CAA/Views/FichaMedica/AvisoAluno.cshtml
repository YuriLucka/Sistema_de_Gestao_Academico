@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Ficha Médica Recebida</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 48 48'%3E%3Crect width='48' height='48' rx='8' fill='%2300AD8E'/%3E%3Ctext x='24' y='32' text-anchor='middle' font-size='28' font-family='Arial, Helvetica, sans-serif' fill='white' font-weight='bold'%3EA%3C/text%3E%3C/svg%3E" />
    <style>
        body {
            background: linear-gradient(135deg, #e0f7f4 0%, #a6d8cc 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .card {
            border-radius: 18px;
            box-shadow: 0 8px 32px rgba(0, 89, 78, 0.15);
            padding: 40px 32px;
            max-width: 400px;
            text-align: center;
            background: #fff;
        }

            .card .icon {
                font-size: 3rem;
                color: #00ad8e;
                margin-bottom: 18px;
            }

            .card h2 {
                color: #00594e;
                font-weight: 700;
                margin-bottom: 12px;
            }

            .card p {
                color: #646363;
                font-size: 1.1rem;
                margin-bottom: 0;
            }
    </style>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
</head>
<body>
    <div class="card">
        <div class="icon">
            <i class="fa fa-check-circle"></i>
        </div>
        <h2>Obrigado pelo envio!</h2>
        <p>
            Sua ficha médica foi recebida com sucesso!<br>
        </p>
    </div>
</body>
</html>