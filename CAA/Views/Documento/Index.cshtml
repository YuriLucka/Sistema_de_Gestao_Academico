@model IEnumerable<CAA.Models.Documento>
@{
    ViewData["Title"] = "Documentos";

    string GetIcon(string nome)
    {
        var ext = System.IO.Path.GetExtension(nome).ToLowerInvariant();
        return ext switch
        {
            ".jpg" or ".jpeg" or ".png" or ".gif" or ".bmp" => "bi bi-image",
            ".pdf" => "bi bi-file-earmark-pdf",
            ".doc" or ".docx" => "bi bi-file-earmark-word",
            ".xls" or ".xlsx" => "bi bi-file-earmark-excel",
            _ => "bi bi-file-earmark"
        };
    }

    string GetIconColor(string nome)
    {
        var ext = System.IO.Path.GetExtension(nome).ToLowerInvariant();
        return ext switch
        {
            ".jpg" or ".jpeg" or ".png" or ".gif" or ".bmp" => "#8b5cf6", // Roxo/Púrpura
            ".pdf" => "#dc3545", // Vermelho
            ".doc" or ".docx" => "#0d6efd", // Azul
            ".xls" or ".xlsx" => "#198754", // Verde
            _ => "#6c757d" // Cinza
        };
    }


    bool IsVisualizable(string nome)
    {
        var ext = System.IO.Path.GetExtension(nome).ToLowerInvariant();
        return ext == ".pdf" || ext == ".jpg" || ext == ".jpeg" || ext == ".png" || ext == ".gif" || ext == ".bmp";
    }

    string selectedTipo = Context.Request.Query["tipo"];
    var tipos = new[] {
        new { Value = "", Text = "Todos" },
        new { Value = "imagem", Text = "Imagem" },
        new { Value = "pdf", Text = "PDF" },
        new { Value = "word", Text = "Word" },
        new { Value = "excel", Text = "Excel" }
    };
}

<style>
    :root {
        --primary-green: #25D366;
        --secondary-green: #128C7E;
        --dark-green: #075E54;
        --light-green: rgba(37, 211, 102, 0.1);
    }

    /* ============================================
                           HEADER ACTIONS BAR
                           ============================================ */
    .actions-bar {
        background: linear-gradient(135deg, rgba(37, 211, 102, 0.05) 0%, rgba(18, 140, 126, 0.05) 100%);
        border-radius: 16px;
        padding: 1.5rem;
        margin-bottom: 2rem;
        border: 1px solid rgba(37, 211, 102, 0.2);
        backdrop-filter: blur(10px);
    }

    .filter-container {
        display: flex;
        gap: 1rem;
        flex-wrap: wrap;
        align-items: center;
    }

    .filter-group {
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .filter-label {
        font-weight: 600;
        color: var(--secondary-green);
        font-size: 0.95rem;
        margin-bottom: 0;
        white-space: nowrap;
    }

    .form-select-custom,
    .form-control-custom {
        border: 2px solid var(--primary-green);
        border-radius: 12px;
        padding: 0.65rem 1rem;
        transition: all 0.3s ease;
        font-size: 0.95rem;
    }

        .form-select-custom:focus,
        .form-control-custom:focus {
            border-color: var(--primary-green);
            box-shadow: 0 0 0 3px var(--light-green);
            outline: none;
        }

        .form-control-custom::placeholder {
            color: #9ca3af;
        }

    .btn-new-document {
        background: linear-gradient(135deg, var(--primary-green) 0%, var(--secondary-green) 100%);
        border: none;
        border-radius: 16px;
        padding: 1rem 2rem;
        color: white;
        font-weight: 600;
        transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        box-shadow: 0 4px 15px rgba(37, 211, 102, 0.2);
        position: relative;
        overflow: hidden;
        white-space: nowrap;
    }

        .btn-new-document::before {
            content: '';
            position: absolute;
            top: 50%;
            left: 50%;
            width: 0;
            height: 0;
            border-radius: 50%;
            background: rgba(255, 255, 255, 0.3);
            transform: translate(-50%, -50%);
            transition: width 0.6s ease, height 0.6s ease;
        }

        .btn-new-document:hover::before {
            width: 300px;
            height: 300px;
        }

        .btn-new-document:hover {
            transform: translateY(-3px);
            box-shadow: 0 8px 25px rgba(37, 211, 102, 0.35);
            color: white;
        }

        .btn-new-document i,
        .btn-new-document span {
            position: relative;
            z-index: 1;
        }


    /* ============================================
                ENHANCED DOCUMENT CARDS
                ============================================ */
    .documents-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
        gap: 2rem;
        margin-top: 2rem;
        perspective: 1000px;
    }

    .documento-card {
        animation: fadeInUp 0.6s ease-out forwards;
        animation-delay: calc(var(--card-index) * 0.1s);
        opacity: 0;
    }

    @@keyframes fadeInUp {
        from {
            opacity: 0;
            transform: translateY(30px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .document-card {
        position: relative;
        border-radius: 20px;
        padding: 2rem 1.5rem;
        transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        border: 2px solid transparent;
        background: linear-gradient(145deg, #ffffff 0%, #f8f9fa 100%);
        overflow: hidden;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.08);
        cursor: pointer;
    }

        .document-card:hover {
            transform: translateY(-12px) scale(1.02);
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.15);
            border-color: transparent;
        }

        /* ============================================
                    TYPE-SPECIFIC CARD STYLING WITH GRADIENTS
                    ============================================ */
        .document-card[data-type="image"] {
            background: linear-gradient(145deg, #f5f3ff 0%, #ede9fe 100%);
        }

        .document-card[data-type="pdf"] {
            background: linear-gradient(145deg, #fef2f2 0%, #fee2e2 100%);
        }

        .document-card[data-type="word"] {
            background: linear-gradient(145deg, #eff6ff 0%, #dbeafe 100%);
        }

        .document-card[data-type="excel"] {
            background: linear-gradient(145deg, #f0fdf4 0%, #dcfce7 100%);
        }

        .document-card[data-type="default"] {
            background: linear-gradient(145deg, #f9fafb 0%, #f3f4f6 100%);
        }

    /* ============================================
                ENHANCED ICON WRAPPER WITH ANIMATIONS
                ============================================ */
    .document-icon-wrapper {
        width: 90px;
        height: 90px;
        margin: 0 auto 1.25rem;
        border-radius: 20px;
        display: flex;
        align-items: center;
        justify-content: center;
        position: relative;
        transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        background: rgba(255, 255, 255, 0.9);
        backdrop-filter: blur(10px);
        box-shadow: 0 8px 20px rgba(0, 0, 0, 0.1);
    }

    .document-card:hover .document-icon-wrapper {
        transform: scale(1.15) rotateY(10deg);
        box-shadow: 0 15px 35px rgba(0, 0, 0, 0.2);
    }

    .document-icon {
        font-size: 3rem;
        transition: all 0.4s cubic-bezier(0.68, -0.55, 0.265, 1.55);
        position: relative;
        z-index: 1;
        filter: drop-shadow(0 4px 8px rgba(0, 0, 0, 0.1));
    }

    .document-card:hover .document-icon {
        transform: scale(1.2) rotateZ(-5deg);
        filter: drop-shadow(0 8px 16px rgba(0, 0, 0, 0.2));
    }

    /* ============================================
                ENHANCED TITLE WITH GRADIENT
                ============================================ */
    .document-title {
        font-size: 1.1rem;
        font-weight: 700;
        margin-bottom: 1.25rem;
        text-align: center;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        background: linear-gradient(135deg, #1f2937 0%, #4b5563 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        transition: all 0.3s ease;
        position: relative;
    }

    .document-card:hover .document-title {
        transform: scale(1.05);
        letter-spacing: 0.5px;
    }

    /* Animated underline */
    .document-title::after {
        content: '';
        position: absolute;
        bottom: -4px;
        left: 50%;
        width: 0;
        height: 3px;
        background: linear-gradient(90deg, var(--primary-green), var(--secondary-green));
        transition: all 0.4s ease;
        transform: translateX(-50%);
        border-radius: 2px;
    }

    .document-card:hover .document-title::after {
        width: 80%;
    }

    /* ============================================
                ENHANCED ACTION BUTTONS
                ============================================ */
    .document-actions {
        display: flex;
        gap: 0.65rem;
        justify-content: center;
        flex-wrap: wrap;
        opacity: 0.7;
        transition: opacity 0.3s ease;
    }

    .document-card:hover .document-actions {
        opacity: 1;
    }

    .btn-action {
        width: 42px;
        height: 42px;
        border-radius: 12px;
        border: none;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        font-size: 1.1rem;
        position: relative;
        overflow: hidden;
        box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
    }

        /* Ripple effect */
        .btn-action::before {
            content: '';
            position: absolute;
            top: 50%;
            left: 50%;
            width: 0;
            height: 0;
            border-radius: 50%;
            background: rgba(255, 255, 255, 0.5);
            transform: translate(-50%, -50%);
            transition: width 0.6s ease, height 0.6s ease;
        }

        .btn-action:active::before {
            width: 100px;
            height: 100px;
        }

    .btn-action-view {
        background: linear-gradient(135deg, #3b82f6 0%, #1e40af 100%);
        color: white;
    }

        .btn-action-view:hover {
            background: linear-gradient(135deg, #2563eb 0%, #1e3a8a 100%);
            transform: translateY(-3px) scale(1.1);
            box-shadow: 0 8px 20px rgba(59, 130, 246, 0.4);
        }

    .btn-action-download {
        background: linear-gradient(135deg, var(--primary-green) 0%, var(--secondary-green) 100%);
        color: white;
    }

        .btn-action-download:hover {
            background: linear-gradient(135deg, #22c55e 0%, #16a34a 100%);
            transform: translateY(-3px) scale(1.1);
            box-shadow: 0 8px 20px rgba(37, 211, 102, 0.4);
        }

    .btn-action-edit {
        background: linear-gradient(135deg, #fbbf24 0%, #f59e0b 100%);
        color: white;
    }

        .btn-action-edit:hover {
            background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
            transform: translateY(-3px) scale(1.1);
            box-shadow: 0 8px 20px rgba(251, 191, 36, 0.4);
        }

    .btn-action-delete {
        background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%);
        color: white;
    }

        .btn-action-delete:hover {
            background: linear-gradient(135deg, #dc2626 0%, #b91c1c 100%);
            transform: translateY(-3px) scale(1.1);
            box-shadow: 0 8px 20px rgba(239, 68, 68, 0.4);
        }

    /* ============================================
                MODAL STYLES
                ============================================ */
    .modal-content {
        border-radius: 16px;
        border: none;
        box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
    }

    .modal-header {
        border-bottom: 2px solid var(--primary-green);
        padding: 1.5rem;
        border-radius: 16px 16px 0 0;
        background: linear-gradient(135deg, rgba(37, 211, 102, 0.05) 0%, rgba(18, 140, 126, 0.05) 100%);
    }

    .modal-title {
        color: var(--secondary-green);
        font-weight: 700;
    }

    .modal-body {
        padding: 1.5rem;
    }

    .modal-footer {
        border-top: 2px solid var(--primary-green);
        padding: 1.5rem;
    }

    .btn-primary-custom {
        background: linear-gradient(135deg, var(--primary-green) 0%, var(--secondary-green) 100%);
        border: none;
        border-radius: 10px;
        padding: 0.65rem 1.5rem;
        color: white;
        font-weight: 600;
        transition: all 0.3s ease;
    }

        .btn-primary-custom:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(37, 211, 102, 0.3);
        }

    .btn-secondary-custom {
        background: #f3f4f6;
        border: 2px solid #e5e7eb;
        border-radius: 10px;
        padding: 0.65rem 1.5rem;
        color: #6b7280;
        font-weight: 600;
        transition: all 0.3s ease;
    }

        .btn-secondary-custom:hover {
            background: #e5e7eb;
            border-color: #d1d5db;
        }

    /* ============================================
                EMPTY STATE
                ============================================ */
    .empty-state {
        text-align: center;
        padding: 4rem 2rem;
        color: #6b7280;
    }

        .empty-state i {
            font-size: 4rem;
            color: #d1d5db;
            margin-bottom: 1rem;
        }

        .empty-state h3 {
            color: #374151;
            margin-bottom: 0.5rem;
        }

    /* ============================================
                RESPONSIVE
                ============================================ */
    @@media (max-width: 768px) {
        .documents-grid {
            grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
            gap: 1.5rem;
        }

        .actions-bar {
            padding: 1.25rem;
        }
            /* Stack everything vertically */
            .actions-bar .d-flex.justify-content-between {
                flex-direction: column;
                align-items: stretch !important;
                gap: 1rem !important;
            }
        /* Filter Container stacks vertically */
        .filter-container {
            flex-direction: column;
            align-items: stretch;
            width: 100%;
            gap: 1rem;
        }
            /* Form tag inside filter container */
            .filter-container form {
                width: 100%;
                flex-direction: column;
                align-items: stretch !important;
            }
        /* Filter Groups (Label + Input) stack */
        .filter-group {
            flex-direction: column;
            align-items: flex-start;
            width: 100%;
            gap: 0.25rem;
        }

        .form-select-custom,
        .form-control-custom {
            width: 100% !important;
            min-width: 100% !important;
        }

        .btn-new-document {
            width: 100%;
            justify-content: center;
        }

        .document-icon-wrapper {
            width: 75px;
            height: 75px;
        }

        .document-icon {
            font-size: 2.5rem;
        }
    }
</style>

<!-- Actions Bar -->
<div class="actions-bar">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
        <!-- Filters -->
        <div class="filter-container flex-grow-1">
            <!-- Filter Type Group -->
            <form method="get" class="d-flex align-items-center gap-2 flex-wrap flex-grow-1">
                <div class="filter-group w-auto">
                    <label for="tipo" class="filter-label">
                        <i class="bi bi-funnel me-1"></i> Filtrar:
                    </label>
                    <select name="tipo" id="tipo" class="form-select form-select-custom" style="width: auto; min-width: 150px;" onchange="this.form.submit()">
                        @foreach (var t in tipos)
                        {
                            <option value="@t.Value" selected="@(selectedTipo == t.Value)">@t.Text</option>
                        }
                    </select>
                </div>
            </form>

            <!-- Search Group -->
            <div class="filter-group flex-grow-1">
                <label for="documentoFilter" class="filter-label">
                    <i class="bi bi-search me-1"></i> Buscar:
                </label>
                <input type="text" id="documentoFilter" class="form-control form-control-custom w-100" placeholder="Digite a descrição..." />
            </div>
        </div>

        <!-- New Document Button -->
        @if (User.IsInRole("Admin"))
        {
            <button type="button" class="btn-new-document" data-bs-toggle="modal" data-bs-target="#novoDocumentoModal">
                <i class="bi bi-plus-circle"></i>
                <span>Novo Documento</span>
            </button>
        }
    </div>
</div>

<!-- Documents Grid -->
<div class="documents-grid" id="documentosContainer">
    @if (Model.Any())
    {
        int cardIndex = 0;
        @foreach (var doc in Model)
        {
            var docType = System.IO.Path.GetExtension(doc.Nome).ToLowerInvariant() switch
            {
                ".jpg" or ".jpeg" or ".png" or ".gif" or ".bmp" => "image",
                ".pdf" => "pdf",
                ".doc" or ".docx" => "word",
                ".xls" or ".xlsx" => "excel",
                _ => "default"
            };

            <div class="documento-card" style="--card-index: @cardIndex;">
                <div class="document-card" data-type="@docType">
                    <div class="document-icon-wrapper" style="color: @GetIconColor(doc.Nome);">
                        <i class="@GetIcon(doc.Nome) document-icon"></i>
                    </div>
                    <h5 class="document-title" title="@doc.Descricao">@doc.Descricao</h5>
                    <div class="document-actions">
                        @if (IsVisualizable(doc.Nome))
                        {
                            <a asp-action="Visualizar" asp-route-id="@doc.DocumentoId" target="_blank"
                               class="btn-action btn-action-view" title="Visualizar">
                                <i class="bi bi-eye"></i>
                            </a>
                        }
                        <a asp-action="Download" asp-route-id="@doc.DocumentoId"
                           class="btn-action btn-action-download" title="Baixar">
                            <i class="bi bi-download"></i>
                        </a>
                        @if (User.IsInRole("Admin"))
                        {
                            <button type="button" class="btn-action btn-action-edit renomear-btn"
                                    data-bs-toggle="modal" data-bs-target="#renomearDocumentoModal"
                                    data-id="@doc.DocumentoId" data-descricao="@doc.Descricao" title="Renomear">
                                <i class="bi bi-pencil-square"></i>
                            </button>
                            <form asp-action="Delete" asp-route-id="@doc.DocumentoId" method="post" class="d-inline delete-documento-form">
                                <button type="button" class="btn-action btn-action-delete delete-btn" title="Excluir">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </form>
                        }
                    </div>
                </div>
            </div>
            cardIndex++;
        }
    }
    else
    {
        <div class="col-12">
            <div class="empty-state">
                <i class="bi bi-folder2-open"></i>
                <h3>Nenhum documento encontrado</h3>
                <p>Adicione seu primeiro documento para começar</p>
            </div>
        </div>
    }
</div>

<!-- Modal Novo Documento -->
<div class="modal fade" id="novoDocumentoModal" tabindex="-1" aria-labelledby="novoDocumentoModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="novoDocumentoModalLabel">
                    <i class="bi bi-file-earmark-plus me-2"></i>Novo Documento
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
            </div>
            <div class="modal-body">
                <form asp-action="Create" enctype="multipart/form-data" method="post" id="formNovoDocumento">
                    <div class="mb-3">
                        <label for="Descricao" class="form-label fw-semibold">
                            <i class="bi bi-card-text me-1"></i>Descrição
                        </label>
                        <input name="Descricao" id="Descricao" class="form-control form-control-custom" required placeholder="Digite a descrição do documento" />
                    </div>
                    <div class="mb-3">
                        <label for="arquivo" class="form-label fw-semibold">
                            <i class="bi bi-paperclip me-1"></i>Arquivo
                        </label>
                        <input type="file" name="arquivo" id="arquivo" class="form-control form-control-custom"
                               accept=".jpg,.jpeg,.png,.gif,.bmp,.pdf,.doc,.docx,.xls,.xlsx" required />
                        <small class="form-text text-muted mt-2 d-block">
                            <i class="bi bi-info-circle me-1"></i>
                            Tipos: Imagem, PDF, Word, Excel | Máximo: 100MB
                        </small>
                    </div>
                    <div class="modal-footer px-0 pb-0">
                        <button type="button" class="btn btn-secondary-custom" data-bs-dismiss="modal">
                            <i class="bi bi-x-circle me-1"></i>Cancelar
                        </button>
                        <button type="submit" class="btn btn-primary-custom" id="btnSalvarDocumento" style="display:none;">
                            <i class="bi bi-check-circle me-1"></i>Salvar
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Modal Renomear Documento -->
<div class="modal fade" id="renomearDocumentoModal" tabindex="-1" aria-labelledby="renomearDocumentoModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="renomearDocumentoModalLabel">
                    <i class="bi bi-pencil-square me-2"></i>Renomear Documento
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
            </div>
            <div class="modal-body">
                <form id="renomearDocumentoForm" asp-action="RenomearDescricao" method="post">
                    <input type="hidden" name="DocumentoId" id="RenomearDocumentoId" />
                    <div class="mb-3">
                        <label for="RenomearDescricao" class="form-label fw-semibold">
                            <i class="bi bi-card-text me-1"></i>Nova Descrição
                        </label>
                        <input name="Descricao" id="RenomearDescricao" class="form-control form-control-custom" required placeholder="Digite a nova descrição" />
                    </div>
                    <div class="modal-footer px-0 pb-0">
                        <button type="button" class="btn btn-secondary-custom" data-bs-dismiss="modal">
                            <i class="bi bi-x-circle me-1"></i>Cancelar
                        </button>
                        <button type="submit" class="btn btn-primary-custom">
                            <i class="bi bi-check-circle me-1"></i>Salvar
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        // Toggle Salvar button
        var descricaoInput = document.getElementById('Descricao');
        var arquivoInput = document.getElementById('arquivo');
        var btnSalvar = document.getElementById('btnSalvarDocumento');

        function toggleSalvarBtn() {
            if (descricaoInput.value.trim() && arquivoInput.files.length > 0) {
                btnSalvar.style.display = '';
            } else {
                btnSalvar.style.display = 'none';
            }
        }

        descricaoInput.addEventListener('input', toggleSalvarBtn);
        arquivoInput.addEventListener('change', toggleSalvarBtn);

        document.getElementById('novoDocumentoModal').addEventListener('shown.bs.modal', function () {
            toggleSalvarBtn();
            descricaoInput.focus();
        });

        // Renomear modal
        document.addEventListener('DOMContentLoaded', function () {
            var renomearBtns = document.querySelectorAll('.renomear-btn');
            renomearBtns.forEach(function (btn) {
                btn.addEventListener('click', function () {
                    var id = btn.getAttribute('data-id');
                    var descricao = btn.getAttribute('data-descricao');
                    document.getElementById('RenomearDocumentoId').value = id;
                    document.getElementById('RenomearDescricao').value = descricao;
                });
            });

            // SweetAlert2 para exclusão
            var deleteBtns = document.querySelectorAll('.delete-btn');
            deleteBtns.forEach(function(btn) {
                btn.addEventListener('click', function(e) {
                    e.preventDefault();
                    var form = btn.closest('form');
                    Swal.fire({
                        title: 'Tem certeza?',
                        text: 'Esta ação não poderá ser desfeita!',
                        icon: 'warning',
                        showCancelButton: true,
                        confirmButtonColor: '#dc3545',
                        cancelButtonColor: '#6c757d',
                        confirmButtonText: '<i class="bi bi-trash me-1"></i> Sim, excluir',
                        cancelButtonText: '<i class="bi bi-x-circle me-1"></i> Cancelar',
                        reverseButtons: true,
                        customClass: {
                            confirmButton: 'btn btn-danger',
                            cancelButton: 'btn btn-secondary'
                        },
                        buttonsStyling: false
                    }).then((result) => {
                        if (result.isConfirmed) {
                            form.submit();
                        }
                    });
                });
            });

            // Filtro de busca
            var filterInput = document.getElementById('documentoFilter');
            filterInput.addEventListener('input', function() {
                var filter = this.value.toLowerCase();
                var cards = document.querySelectorAll('#documentosContainer .documento-card');
                var visibleCount = 0;

                cards.forEach(function(card) {
                    var desc = card.querySelector('.document-title');
                    var text = desc ? desc.textContent.toLowerCase() : '';
                    var shouldShow = text.includes(filter);
                    card.style.display = shouldShow ? '' : 'none';
                    if (shouldShow) visibleCount++;
                });

                // Show empty state if no results
                var emptyState = document.querySelector('.empty-state');
                if (visibleCount === 0 && filter.length > 0) {
                    if (!emptyState) {
                        var container = document.getElementById('documentosContainer');
                        container.innerHTML = `
                            <div class="col-12">
                                <div class="empty-state">
                                    <i class="bi bi-search"></i>
                                    <h3>Nenhum resultado encontrado</h3>
                                    <p>Tente usar outros termos de busca</p>
                                </div>
                            </div>
                        `;
                    }
                } else if (filter.length === 0) {
                    location.reload();
                }
            });
        });
    </script>
}
