@model CAA.Models.Matricula

@{
    ViewData["Title"] = "Excluir Matrícula";
}

<style>
    :root {
        --primary-green: #25D366;
        --secondary-green: #128C7E;
        --dark-green: #075E54;
        --light-green: rgba(37, 211, 102, 0.1);
        --danger-red: #ef4444;
        --danger-light: rgba(239, 68, 68, 0.1);
    }

    /* Page Container */
    .form-page-container {
        max-width: 1200px;
        margin: 0 auto;
    }

    /* Page Header - Warning Style */
    .form-page-header-danger {
        background: linear-gradient(135deg, rgba(239, 68, 68, 0.1) 0%, rgba(220, 38, 38, 0.1) 100%);
        border-radius: 16px;
        padding: 2rem;
        margin-bottom: 2rem;
        border: 2px solid rgba(239, 68, 68, 0.3);
        backdrop-filter: blur(10px);
        text-align: center;
    }

        .form-page-header-danger h1 {
            font-size: 1.75rem;
            font-weight: 700;
            color: #dc2626;
            margin-bottom: 0.5rem;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 0.75rem;
        }

            .form-page-header-danger h1 i {
                font-size: 2rem;
                animation: pulse 2s ease-in-out infinite;
            }

    @@keyframes pulse {
        0%, 100%

    {
        transform: scale(1);
    }

    50% {
        transform: scale(1.1);
    }

    }

    .form-page-header-danger p {
        color: #991b1b;
        margin: 0;
        font-size: 0.95rem;
        font-weight: 500;
    }

    /* Warning Alert */
    .warning-alert {
        background: linear-gradient(135deg, rgba(251, 191, 36, 0.15) 0%, rgba(245, 158, 11, 0.15) 100%);
        border-left: 4px solid #f59e0b;
        border-radius: 12px;
        padding: 1.25rem 1.5rem;
        margin-bottom: 2rem;
        display: flex;
        align-items: start;
        gap: 1rem;
    }

        .warning-alert i {
            font-size: 1.5rem;
            color: #d97706;
            flex-shrink: 0;
            margin-top: 0.125rem;
        }

    .warning-alert-content {
        flex: 1;
    }

        .warning-alert-content h3 {
            color: #92400e;
            font-weight: 700;
            font-size: 1.1rem;
            margin-bottom: 0.5rem;
        }

        .warning-alert-content p {
            color: #78350f;
            margin: 0;
            line-height: 1.6;
        }

    /* Details Card */
    .details-card {
        background: white;
        border-radius: 20px;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
        overflow: hidden;
        border: 2px solid #f3f4f6;
        margin-bottom: 2rem;
    }

    /* Section Headers */
    .details-section-header {
        background: linear-gradient(135deg, var(--light-green) 0%, rgba(18, 140, 126, 0.05) 100%);
        border-bottom: 2px solid #f3f4f6;
        padding: 1.25rem 2rem;
        display: flex;
        align-items: center;
        gap: 0.75rem;
    }

        .details-section-header i {
            font-size: 1.5rem;
            color: var(--secondary-green);
        }

        .details-section-header h2 {
            color: var(--secondary-green);
            font-weight: 700;
            font-size: 1.2rem;
            margin: 0;
        }

    .details-section-body {
        padding: 2rem;
    }

    /* Details Grid - Two Columns */
    .details-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 1.5rem;
    }

    .detail-item {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        padding: 1rem;
        background: #f9fafb;
        border-radius: 12px;
        border: 1px solid #e5e7eb;
        transition: all 0.3s ease;
    }

        .detail-item:hover {
            background: var(--light-green);
            border-color: var(--primary-green);
            transform: translateY(-2px);
        }

    .detail-item-full {
        grid-column: 1 / -1;
    }

    .detail-label {
        font-weight: 600;
        color: var(--secondary-green);
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 0.85rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

        .detail-label i {
            font-size: 1rem;
        }

    .detail-value {
        color: #374151;
        font-size: 1rem;
        font-weight: 500;
        padding: 0.5rem 0;
    }

    .detail-value-empty {
        color: #9ca3af;
        font-style: italic;
    }

    /* Brinde Badge */
    .brinde-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.5rem 1rem;
        border-radius: 20px;
        font-weight: 600;
        font-size: 0.9rem;
    }

    .brinde-yes {
        background: var(--light-green);
        color: var(--secondary-green);
        border: 1px solid var(--primary-green);
    }

    .brinde-no {
        background: rgba(239, 68, 68, 0.1);
        color: #dc2626;
        border: 1px solid #ef4444;
    }

    /* Confirmation Box */
    .confirmation-box {
        background: white;
        border: 2px solid rgba(239, 68, 68, 0.3);
        border-radius: 16px;
        padding: 1.5rem;
        margin: 2rem;
    }

    .confirmation-checkbox {
        display: flex;
        align-items: center;
        gap: 1rem;
        cursor: pointer;
    }

        .confirmation-checkbox input[type="checkbox"] {
            width: 24px;
            height: 24px;
            cursor: pointer;
            accent-color: var(--danger-red);
            border-radius: 6px;
        }

        .confirmation-checkbox label {
            flex: 1;
            cursor: pointer;
            font-size: 1rem;
            color: #374151;
            font-weight: 500;
            user-select: none;
        }

    /* Form Actions */
    .form-actions-danger {
        display: flex;
        gap: 1rem;
        padding: 2rem;
        background: #f9fafb;
        border-top: 2px solid #f3f4f6;
        flex-wrap: wrap;
    }

    .btn-form-danger {
        flex: 1;
        min-width: 180px;
        border-radius: 12px;
        padding: 0.875rem 1.5rem;
        font-size: 0.95rem;
        font-weight: 600;
        border: none;
        transition: all 0.3s ease;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        text-decoration: none;
        cursor: pointer;
        position: relative;
        overflow: hidden;
    }

        .btn-form-danger::before {
            content: '';
            position: absolute;
            top: 50%;
            left: 50%;
            width: 0;
            height: 0;
            border-radius: 50%;
            background: rgba(255, 255, 255, 0.3);
            transform: translate(-50%, -50%);
            transition: width 0.6s ease, height 0.6s ease;
        }

        .btn-form-danger:hover::before {
            width: 300px;
            height: 300px;
        }

        .btn-form-danger i,
        .btn-form-danger span {
            position: relative;
            z-index: 1;
        }

    .btn-delete-confirm {
        background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%);
        color: white;
        box-shadow: 0 4px 15px rgba(239, 68, 68, 0.3);
    }

        .btn-delete-confirm:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(239, 68, 68, 0.4);
            color: white;
        }

    .btn-cancel-danger {
        background: white;
        border: 2px solid #e5e7eb;
        color: #6b7280;
    }

        .btn-cancel-danger:hover {
            background: #f3f4f6;
            border-color: #d1d5db;
            color: #374151;
            transform: translateY(-2px);
        }

    /* Responsive */
    @@media (max-width: 992px) {
        .details-grid

    {
        grid-template-columns: 1fr;
    }

    }

    @@media (max-width: 768px) {
        .details-section-body

    {
        padding: 1.5rem;
    }

    .form-page-header-danger {
        padding: 1.5rem;
    }

        .form-page-header-danger h1 {
            font-size: 1.5rem;
        }

    .form-actions-danger {
        flex-direction: column;
        padding: 1.5rem;
    }

    .btn-form-danger {
        width: 100%;
    }

    }
</style>

<div class="form-page-container">
    <!-- Page Header - Warning -->
    <div class="form-page-header-danger">
        <h1>
            <i class="bi bi-exclamation-triangle"></i>
            Excluir Matrícula
        </h1>
        <p>Atenção! Esta ação é irreversível</p>
    </div>

    <!-- Warning Alert -->
    <div class="warning-alert">
        <i class="bi bi-shield-exclamation"></i>
        <div class="warning-alert-content">
            <h3>Confirmação de Exclusão Necessária</h3>
            <p>
                Você está prestes a excluir permanentemente esta matrícula.
                Todos os dados associados serão removidos do sistema.
                Por favor, revise as informações abaixo antes de confirmar.
            </p>
        </div>
    </div>

    <!-- Details Card -->
    <div class="details-card">
        <!-- Seção: Dados Pessoais -->
        <div class="details-section-header">
            <i class="bi bi-person-badge"></i>
            <h2>Dados Pessoais</h2>
        </div>
        <div class="details-section-body">
            <div class="details-grid">
                <div class="detail-item">
                    <div class="detail-label">
                        <i class="bi bi-person"></i>
                        <span>@Html.DisplayNameFor(model => model.NomeCompleto)</span>
                    </div>
                    <div class="detail-value">
                        @Html.DisplayFor(model => model.NomeCompleto)
                    </div>
                </div>

                <div class="detail-item">
                    <div class="detail-label">
                        <i class="bi bi-calendar-event"></i>
                        <span>@Html.DisplayNameFor(model => model.DataMatricula)</span>
                    </div>
                    <div class="detail-value">
                        @Html.DisplayFor(model => model.DataMatricula)
                    </div>
                </div>

                <div class="detail-item">
                    <div class="detail-label">
                        <i class="bi bi-envelope"></i>
                        <span>@Html.DisplayNameFor(model => model.Email)</span>
                    </div>
                    <div class="detail-value">
                        @Html.DisplayFor(model => model.Email)
                    </div>
                </div>

                <div class="detail-item">
                    <div class="detail-label">
                        <i class="bi bi-phone"></i>
                        <span>@Html.DisplayNameFor(model => model.Celular)</span>
                    </div>
                    <div class="detail-value">
                        @Html.DisplayFor(model => model.Celular)
                    </div>
                </div>
            </div>
        </div>

        <!-- Seção: Formação Anterior -->
        <div class="details-section-header">
            <i class="bi bi-mortarboard"></i>
            <h2>Formação Anterior</h2>
        </div>
        <div class="details-section-body">
            <div class="details-grid">
                <div class="detail-item">
                    <div class="detail-label">
                        <i class="bi bi-building"></i>
                        <span>@Html.DisplayNameFor(model => model.EscolaOrigem)</span>
                    </div>
                    <div class="detail-value">
                        @Html.DisplayFor(model => model.EscolaOrigem)
                    </div>
                </div>

                <div class="detail-item">
                    <div class="detail-label">
                        <i class="bi bi-calendar-check"></i>
                        <span>@Html.DisplayNameFor(model => model.AnoFormacao)</span>
                    </div>
                    <div class="detail-value">
                        @Html.DisplayFor(model => model.AnoFormacao)
                    </div>
                </div>

                <div class="detail-item">
                    <div class="detail-label">
                        <i class="bi bi-geo-alt"></i>
                        <span>@Html.DisplayNameFor(model => model.Cidade)</span>
                    </div>
                    <div class="detail-value">
                        @Html.DisplayFor(model => model.Cidade)
                    </div>
                </div>

                <div class="detail-item">
                    <div class="detail-label">
                        <i class="bi bi-arrow-left-right"></i>
                        <span>@Html.DisplayNameFor(model => model.InstituicaoTransferencia)</span>
                    </div>
                    <div class="detail-value @(string.IsNullOrEmpty(Model.InstituicaoTransferencia) ? "detail-value-empty" : "")">
                        @(string.IsNullOrEmpty(Model.InstituicaoTransferencia) ? "Não informado" : Html.DisplayFor(model => model.InstituicaoTransferencia))
                    </div>
                </div>
            </div>
        </div>

        <!-- Seção: Dados do Curso -->
        <div class="details-section-header">
            <i class="bi bi-book"></i>
            <h2>Dados do Curso</h2>
        </div>
        <div class="details-section-body">
            <div class="details-grid">
                <div class="detail-item">
                    <div class="detail-label">
                        <i class="bi bi-diagram-3"></i>
                        <span>@Html.DisplayNameFor(model => model.Eixo)</span>
                    </div>
                    <div class="detail-value">
                        @Html.DisplayFor(model => model.Eixo.Nome)
                    </div>
                </div>

                <div class="detail-item">
                    <div class="detail-label">
                        <i class="bi bi-journal-bookmark"></i>
                        <span>@Html.DisplayNameFor(model => model.Curso)</span>
                    </div>
                    <div class="detail-value">
                        @Html.DisplayFor(model => model.Curso.Nome)
                    </div>
                </div>

                <div class="detail-item">
                    <div class="detail-label">
                        <i class="bi bi-clock"></i>
                        <span>@Html.DisplayNameFor(model => model.Turno)</span>
                    </div>
                    <div class="detail-value">
                        @Html.DisplayFor(model => model.Turno)
                    </div>
                </div>

                <div class="detail-item">
                    <div class="detail-label">
                        <i class="bi bi-laptop"></i>
                        <span>@Html.DisplayNameFor(model => model.Modalidade)</span>
                    </div>
                    <div class="detail-value">
                        @Html.DisplayFor(model => model.Modalidade)
                    </div>
                </div>
            </div>
        </div>

        <!-- Seção: Informações da Matrícula -->
        <div class="details-section-header">
            <i class="bi bi-file-earmark-check"></i>
            <h2>Informações da Matrícula</h2>
        </div>
        <div class="details-section-body">
            <div class="details-grid">
                <div class="detail-item">
                    <div class="detail-label">
                        <i class="bi bi-shield-check"></i>
                        <span>@Html.DisplayNameFor(model => model.StatusMatricula)</span>
                    </div>
                    <div class="detail-value">
                        @Html.DisplayFor(model => model.StatusMatricula.Nome)
                    </div>
                </div>

                <div class="detail-item">
                    <div class="detail-label">
                        <i class="bi bi-door-open"></i>
                        <span>@Html.DisplayNameFor(model => model.TipoIngresso)</span>
                    </div>
                    <div class="detail-value">
                        @Html.DisplayFor(model => model.TipoIngresso.Nome)
                    </div>
                </div>

                <div class="detail-item">
                    <div class="detail-label">
                        <i class="bi bi-person-check"></i>
                        <span>@Html.DisplayNameFor(model => model.Atendente)</span>
                    </div>
                    <div class="detail-value">
                        @Html.DisplayFor(model => model.Atendente.Id)
                    </div>
                </div>

                <div class="detail-item">
                    <div class="detail-label">
                        <i class="bi bi-gift"></i>
                        <span>@Html.DisplayNameFor(model => model.Brinde)</span>
                    </div>
                    <div class="detail-value">
                        <span class="brinde-badge @(Model.Brinde ? "brinde-yes" : "brinde-no")">
                            <i class="bi @(Model.Brinde ? "bi-check-circle-fill" : "bi-x-circle-fill")"></i>
                            @(Model.Brinde ? "Sim, entregue" : "Não entregue")
                        </span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Seção: Observações -->
        <div class="details-section-header">
            <i class="bi bi-chat-left-text"></i>
            <h2>Observações Adicionais</h2>
        </div>
        <div class="details-section-body">
            <div class="details-grid">
                <div class="detail-item detail-item-full">
                    <div class="detail-label">
                        <i class="bi bi-pencil-square"></i>
                        <span>@Html.DisplayNameFor(model => model.Observacao)</span>
                    </div>
                    <div class="detail-value @(string.IsNullOrEmpty(Model.Observacao) ? "detail-value-empty" : "")">
                        @(string.IsNullOrEmpty(Model.Observacao) ? "Nenhuma observação registrada" : Html.DisplayFor(model => model.Observacao))
                    </div>
                </div>

                <div class="detail-item detail-item-full">
                    <div class="detail-label">
                        <i class="bi bi-lightbulb"></i>
                        <span>@Html.DisplayNameFor(model => model.Motivacao)</span>
                    </div>
                    <div class="detail-value @(string.IsNullOrEmpty(Model.Motivacao) ? "detail-value-empty" : "")">
                        @(string.IsNullOrEmpty(Model.Motivacao) ? "Nenhuma motivação registrada" : Html.DisplayFor(model => model.Motivacao))
                    </div>
                </div>
            </div>
        </div>

        <!-- Form Actions -->
        <form asp-action="Delete" method="post" id="deleteForm">
            <input type="hidden" asp-for="MatriculaId" />

            <!-- Confirmation Checkbox -->
            <div class="confirmation-box">
                <div class="confirmation-checkbox">
                    <input type="checkbox" id="confirmDelete" />
                    <label for="confirmDelete">
                        Confirmo que li todas as informações acima e desejo excluir permanentemente esta matrícula
                    </label>
                </div>
            </div>

            <div class="form-actions-danger">
                <button type="submit" class="btn-form-danger btn-delete-confirm" id="deleteButton" disabled>
                    <i class="bi bi-trash"></i>
                    <span>Confirmar Exclusão</span>
                </button>
                <a asp-action="Index" class="btn-form-danger btn-cancel-danger">
                    <i class="bi bi-arrow-left-circle"></i>
                    <span>Cancelar e Voltar</span>
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Checkbox confirmation
            const checkbox = document.getElementById('confirmDelete');
            const deleteButton = document.getElementById('deleteButton');
            const deleteForm = document.getElementById('deleteForm');

            checkbox.addEventListener('change', function() {
                deleteButton.disabled = !this.checked;
                if (this.checked) {
                    deleteButton.style.opacity = '1';
                    deleteButton.style.cursor = 'pointer';
                } else {
                    deleteButton.style.opacity = '0.5';
                    deleteButton.style.cursor = 'not-allowed';
                }
            });

            // Initial state
            deleteButton.style.opacity = '0.5';
            deleteButton.style.cursor = 'not-allowed';

            // SweetAlert confirmation on submit
            deleteForm.addEventListener('submit', function(e) {
                e.preventDefault();

                Swal.fire({
                    title: 'Última Confirmação',
                    html: '<p style="font-size: 1rem; margin-bottom: 1rem;">Tem <strong>absoluta certeza</strong> que deseja excluir esta matrícula?</p><p style="color: #dc2626; font-weight: 600;">Esta ação NÃO pode ser desfeita!</p>',
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#ef4444',
                    cancelButtonColor: '#6b7280',
                    confirmButtonText: '<i class="bi bi-trash me-1"></i> Sim, excluir definitivamente',
                    cancelButtonText: '<i class="bi bi-x-circle me-1"></i> Não, cancelar',
                    reverseButtons: true,
                    customClass: {
                        confirmButton: 'btn btn-danger px-4 py-2',
                        cancelButton: 'btn btn-secondary px-4 py-2'
                    },
                    buttonsStyling: false,
                    focusCancel: true
                }).then((result) => {
                    if (result.isConfirmed) {
                        deleteForm.submit();
                    }
                });
            });

            // Entry animation
            const card = document.querySelector('.details-card');
            card.style.opacity = '0';
            card.style.transform = 'translateY(20px)';

            setTimeout(function() {
                card.style.transition = 'all 0.5s ease';
                card.style.opacity = '1';
                card.style.transform = 'translateY(0)';
            }, 100);
        });
    </script>
}
