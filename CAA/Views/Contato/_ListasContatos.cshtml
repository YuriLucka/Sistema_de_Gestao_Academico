@{
    var listaSelecionada = ViewBag.ListaSelecionada as string ?? "contatosInternos";
    var contatosInternos = ViewBag.ContatosInternos as IEnumerable<CAA.Models.ContatoInterno> ?? Enumerable.Empty<CAA.Models.ContatoInterno>();
    var contatosExternos = ViewBag.ContatosExternos as IEnumerable<CAA.Models.ContatoExterno> ?? Enumerable.Empty<CAA.Models.ContatoExterno>();
    var contatosProfessores = ViewBag.ContatosProfessores as IEnumerable<CAA.Models.ContatoProfessor> ?? Enumerable.Empty<CAA.Models.ContatoProfessor>();
    var contatosPorDepartamento = contatosInternos.GroupBy(c => c.Departamento?.Nome ?? "Sem Departamento").OrderBy(g => g.Key);
}

<style>
    :root {
        --primary-green: #128C7E;
        --light-green: #25D366;
        --gradient-start: rgba(37, 211, 102, 0.08);
        --gradient-end: rgba(18, 140, 126, 0.12);
        --shadow-sm: 0 2px 8px rgba(0, 0, 0, 0.04);
        --shadow-md: 0 8px 24px rgba(18, 140, 126, 0.12);
        --shadow-lg: 0 12px 40px rgba(18, 140, 126, 0.18);
        --shadow-xl: 0 20px 60px rgba(18, 140, 126, 0.25);
        --radius-sm: 16px;
        --radius-md: 20px;
        --radius-lg: 28px;
        --transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    }

    /* Prevenir scroll horizontal global */
    body {
        overflow-x: hidden;
    }

    /* Container principal com glassmorphism sutil */
    .contatos-page-wrapper {
        background: linear-gradient(135deg, var(--gradient-start) 0%, var(--gradient-end) 100%);
        backdrop-filter: blur(10px);
        border-radius: var(--radius-lg);
        padding: 2rem;
        margin: 0 auto;
        max-width: 1400px;
        width: 100%;
        box-sizing: border-box;
        overflow-x: hidden;
    }

    /* Tabs ultra modernos com glassmorphism */
    .contatos-page-tabs-container {
        display: flex;
        justify-content: center;
        gap: 1.25rem;
        margin-bottom: 2.5rem;
        flex-wrap: wrap;
        background: rgba(255, 255, 255, 0.5);
        backdrop-filter: blur(20px) saturate(180%);
        -webkit-backdrop-filter: blur(20px) saturate(180%);
        padding: 1.25rem;
        border-radius: var(--radius-md);
        box-shadow: var(--shadow-md);
        border: 1px solid rgba(255, 255, 255, 0.3);
        width: 100%;
        box-sizing: border-box;
    }

    .contatos-page-tab-button {
        position: relative;
        border-radius: var(--radius-sm);
        padding: 1.125rem 2.5rem;
        font-weight: 700;
        font-size: 1.05rem;
        border: 2px solid transparent;
        transition: var(--transition);
        cursor: pointer;
        overflow: hidden;
        backdrop-filter: blur(10px);
        letter-spacing: 0.3px;
        flex-shrink: 1;
        min-width: 0;
    }

        .contatos-page-tab-button::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: linear-gradient(135deg, rgba(255, 255, 255, 0.2) 0%, rgba(255, 255, 255, 0) 100%);
            opacity: 0;
            transition: opacity 0.4s ease;
        }

        .contatos-page-tab-button::after {
            content: '';
            position: absolute;
            top: 50%;
            left: 50%;
            width: 0;
            height: 0;
            border-radius: 50%;
            background: rgba(255, 255, 255, 0.4);
            transform: translate(-50%, -50%);
            transition: width 0.6s ease, height 0.6s ease;
        }

        .contatos-page-tab-button:hover::before {
            opacity: 1;
        }

        .contatos-page-tab-button:hover::after {
            width: 400px;
            height: 400px;
        }

        .contatos-page-tab-button:hover {
            transform: translateY(-4px);
            box-shadow: var(--shadow-lg);
            border-color: rgba(255, 255, 255, 0.5);
        }

        .contatos-page-tab-button:active {
            transform: translateY(-2px);
        }

        .contatos-page-tab-button i,
        .contatos-page-tab-button span {
            position: relative;
            z-index: 1;
        }

        .contatos-page-tab-button i {
            margin-right: 0.625rem;
            font-size: 1.2rem;
        }

    .contatos-page-tab-success {
        background: linear-gradient(135deg, #34d399 0%, #10b981 100%);
        color: white;
        box-shadow: var(--shadow-md);
    }

        .contatos-page-tab-success:hover {
            background: linear-gradient(135deg, #10b981 0%, #059669 100%);
        }

    .contatos-page-tab-primary {
        background: linear-gradient(135deg, #60a5fa 0%, #3b82f6 100%);
        color: white;
        box-shadow: var(--shadow-md);
    }

        .contatos-page-tab-primary:hover {
            background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%);
        }

    .contatos-page-tab-warning {
        background: linear-gradient(135deg, #fbbf24 0%, #f59e0b 100%);
        color: #1f2937;
        box-shadow: var(--shadow-md);
    }

        .contatos-page-tab-warning:hover {
            background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
        }

    /* Card de contatos premium */
    .contatos-page-contact-card {
        background: rgba(255, 255, 255, 0.95);
        backdrop-filter: blur(20px) saturate(180%);
        -webkit-backdrop-filter: blur(20px) saturate(180%);
        border-radius: var(--radius-lg);
        border: 1px solid rgba(255, 255, 255, 0.5);
        padding: 0;
        box-shadow: var(--shadow-xl);
        animation: slideUp 0.6s cubic-bezier(0.4, 0, 0.2, 1);
        overflow: hidden;
        position: relative;
        width: 100%;
        box-sizing: border-box;
    }

    @@keyframes slideUp {
        from

    {
        opacity: 0;
        transform: translateY(40px) scale(0.98);
    }

    to {
        opacity: 1;
        transform: translateY(0) scale(1);
    }

    }

    .contatos-page-contact-card-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 2.25rem 2.75rem;
        background: linear-gradient(135deg, var(--gradient-start) 0%, var(--gradient-end) 100%);
        border-bottom: 1px solid rgba(18, 140, 126, 0.1);
        flex-wrap: wrap;
        gap: 1.25rem;
        position: relative;
        box-sizing: border-box;
    }

        .contatos-page-contact-card-header::after {
            content: '';
            position: absolute;
            bottom: 0;
            left: 50%;
            transform: translateX(-50%);
            width: 60%;
            height: 1px;
            background: linear-gradient(90deg, transparent, rgba(18, 140, 126, 0.3), transparent);
        }

        .contatos-page-contact-card-header h5 {
            font-size: 1.625rem;
            font-weight: 800;
            color: var(--primary-green);
            margin: 0;
            display: flex;
            align-items: center;
            gap: 0.875rem;
            letter-spacing: -0.5px;
        }

            .contatos-page-contact-card-header h5 i {
                font-size: 1.875rem;
                filter: drop-shadow(0 2px 4px rgba(18, 140, 126, 0.2));
            }

    .contatos-page-btn-add {
        border-radius: var(--radius-sm);
        padding: 0.875rem 2rem;
        font-weight: 700;
        font-size: 1rem;
        display: inline-flex;
        align-items: center;
        gap: 0.75rem;
        transition: var(--transition);
        box-shadow: var(--shadow-md);
        border: none;
        text-decoration: none;
        letter-spacing: 0.3px;
        position: relative;
        overflow: hidden;
        flex-shrink: 0;
    }

        .contatos-page-btn-add::before {
            content: '';
            position: absolute;
            top: 50%;
            left: 50%;
            width: 0;
            height: 0;
            border-radius: 50%;
            background: rgba(255, 255, 255, 0.3);
            transform: translate(-50%, -50%);
            transition: width 0.5s ease, height 0.5s ease;
        }

        .contatos-page-btn-add:hover::before {
            width: 300px;
            height: 300px;
        }

        .contatos-page-btn-add:hover {
            transform: translateY(-4px) scale(1.02);
            box-shadow: var(--shadow-lg);
        }

        .contatos-page-btn-add i {
            position: relative;
            z-index: 1;
            font-size: 1.125rem;
        }

        .contatos-page-btn-add span {
            position: relative;
            z-index: 1;
        }

    /* Lista de contatos refinada */
    .contatos-page-contacts-list {
        list-style: none;
        padding: 0;
        margin: 0;
        max-height: 650px;
        overflow-y: auto;
        overflow-x: hidden;
        width: 100%;
        box-sizing: border-box;
    }

        .contatos-page-contacts-list::-webkit-scrollbar {
            width: 10px;
        }

        .contatos-page-contacts-list::-webkit-scrollbar-track {
            background: rgba(243, 244, 246, 0.5);
            border-radius: 10px;
        }

        .contatos-page-contacts-list::-webkit-scrollbar-thumb {
            background: linear-gradient(180deg, #34d399, #10b981);
            border-radius: 10px;
            border: 2px solid rgba(255, 255, 255, 0.3);
        }

            .contatos-page-contacts-list::-webkit-scrollbar-thumb:hover {
                background: linear-gradient(180deg, #10b981, #059669);
            }

    /* Header de grupo premium */
    .contatos-page-contact-group-header {
        background: linear-gradient(135deg, #ecfdf5 0%, #d1fae5 100%);
        padding: 1.25rem 2.25rem;
        font-weight: 800;
        color: var(--primary-green);
        font-size: 1.15rem;
        border-bottom: 2px solid rgba(16, 185, 129, 0.2);
        position: sticky;
        top: 0;
        z-index: 10;
        display: flex;
        align-items: center;
        gap: 0.875rem;
        letter-spacing: 0.3px;
        box-shadow: 0 2px 8px rgba(18, 140, 126, 0.08);
        box-sizing: border-box;
        width: 100%;
        word-wrap: break-word;
    }

        .contatos-page-contact-group-header i {
            font-size: 1.35rem;
            filter: drop-shadow(0 2px 4px rgba(18, 140, 126, 0.15));
            flex-shrink: 0;
        }

    /* Item de contato ultra refinado */
    .contatos-page-contact-item {
        padding: 1.75rem 2.25rem;
        border-bottom: 1px solid rgba(243, 244, 246, 0.8);
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 1.5rem;
        transition: var(--transition);
        flex-wrap: wrap;
        position: relative;
        background: linear-gradient(90deg, transparent 0%, transparent 100%);
        box-sizing: border-box;
        width: 100%;
    }

        .contatos-page-contact-item::before {
            content: '';
            position: absolute;
            left: 0;
            top: 0;
            bottom: 0;
            width: 4px;
            background: linear-gradient(180deg, #34d399, #10b981);
            opacity: 0;
            transition: opacity 0.4s ease;
            border-radius: 0 4px 4px 0;
        }

        .contatos-page-contact-item:last-child {
            border-bottom: none;
        }

        .contatos-page-contact-item:hover {
            background: linear-gradient(90deg, rgba(37, 211, 102, 0.04) 0%, rgba(18, 140, 126, 0.06) 100%);
            transform: translateX(8px);
            box-shadow: var(--shadow-sm);
        }

            .contatos-page-contact-item:hover::before {
                opacity: 1;
            }

    .contatos-page-contact-info {
        flex: 1;
        min-width: 200px;
        max-width: 100%;
        word-wrap: break-word;
        overflow-wrap: break-word;
    }

        .contatos-page-contact-info strong {
            font-size: 1.2rem;
            color: #111827;
            display: block;
            margin-bottom: 0.625rem;
            font-weight: 800;
            letter-spacing: -0.3px;
            word-wrap: break-word;
        }

    .contatos-page-contact-details {
        font-size: 0.975rem;
        color: #6b7280;
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
        align-items: center;
        width: 100%;
    }

        .contatos-page-contact-details span {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            padding: 0.375rem 0.75rem;
            background: rgba(243, 244, 246, 0.6);
            border-radius: 8px;
            transition: var(--transition);
            word-wrap: break-word;
            overflow-wrap: break-word;
            max-width: 100%;
        }

            .contatos-page-contact-details span:hover {
                background: rgba(18, 140, 126, 0.08);
                transform: translateY(-2px);
            }

        .contatos-page-contact-details i {
            color: var(--light-green);
            font-size: 1rem;
            flex-shrink: 0;
        }

    /* Botões de ação premium */
    .contatos-page-contact-actions {
        display: flex;
        gap: 0.875rem;
        margin-left: auto;
        flex-shrink: 0;
    }

    .contatos-page-btn-action {
        padding: 0.75rem;
        border-radius: 14px;
        border: 2px solid transparent;
        font-size: 1.2rem;
        font-weight: 600;
        transition: var(--transition);
        display: inline-flex;
        align-items: center;
        justify-content: center;
        text-decoration: none;
        cursor: pointer;
        min-width: 48px;
        height: 48px;
        position: relative;
        overflow: hidden;
        backdrop-filter: blur(10px);
        flex-shrink: 0;
    }

        .contatos-page-btn-action::before {
            content: '';
            position: absolute;
            top: 50%;
            left: 50%;
            width: 0;
            height: 0;
            border-radius: 50%;
            background: rgba(255, 255, 255, 0.5);
            transform: translate(-50%, -50%);
            transition: width 0.5s ease, height 0.5s ease;
        }

        .contatos-page-btn-action:hover::before {
            width: 100px;
            height: 100px;
        }

        .contatos-page-btn-action i {
            position: relative;
            z-index: 1;
        }

    .contatos-page-btn-edit {
        background: linear-gradient(135deg, #fbbf24 0%, #f59e0b 100%);
        color: white;
        box-shadow: var(--shadow-md);
    }

        .contatos-page-btn-edit:hover {
            background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
            transform: translateY(-4px) rotate(5deg) scale(1.1);
            box-shadow: 0 12px 28px rgba(251, 191, 36, 0.4);
            border-color: rgba(255, 255, 255, 0.4);
        }

    .contatos-page-btn-delete {
        background: linear-gradient(135deg, #f87171 0%, #ef4444 100%);
        color: white;
        box-shadow: var(--shadow-md);
    }

        .contatos-page-btn-delete:hover {
            background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%);
            transform: translateY(-4px) rotate(-5deg) scale(1.1);
            box-shadow: 0 12px 28px rgba(239, 68, 68, 0.4);
            border-color: rgba(255, 255, 255, 0.4);
        }

    /* Estado vazio elegante */
    .contatos-page-empty-state {
        text-align: center;
        padding: 5rem 2rem;
        color: #9ca3af;
    }

        .contatos-page-empty-state i {
            font-size: 5rem;
            color: #d1d5db;
            margin-bottom: 2rem;
            display: block;
            filter: drop-shadow(0 4px 12px rgba(0, 0, 0, 0.1));
            animation: float 3s ease-in-out infinite;
        }

    @@keyframes float {
        0%, 100%

    {
        transform: translateY(0);
    }

    50% {
        transform: translateY(-15px);
    }

    }

    .contatos-page-empty-state p {
        font-size: 1.2rem;
        font-weight: 600;
        margin: 0;
        letter-spacing: 0.3px;
    }

    /* Responsive aprimorado */
    @@media (max-width: 992px) {
        .contatos-page-wrapper

    {
        padding: 1.75rem;
    }

    .contatos-page-contact-item {
        gap: 1.25rem;
    }

    .contatos-page-contact-info {
        min-width: 180px;
    }

    }

    @@media (max-width: 768px) {
        .contatos-page-wrapper

    {
        padding: 1.25rem;
    }

    .contatos-page-tabs-container {
        gap: 0.75rem;
        padding: 1rem;
    }

    .contatos-page-tab-button {
        padding: 0.875rem 1.5rem;
        font-size: 0.975rem;
    }

    .contatos-page-contact-card-header {
        padding: 1.75rem 1.5rem;
        flex-direction: column;
        align-items: stretch;
    }

        .contatos-page-contact-card-header h5 {
            font-size: 1.375rem;
        }

    .contatos-page-btn-add {
        width: 100%;
        justify-content: center;
    }

    .contatos-page-contact-item {
        padding: 1.5rem 1.25rem;
        flex-direction: column;
        align-items: stretch;
        gap: 1rem;
    }

    .contatos-page-contact-info {
        min-width: 100%;
    }

    .contatos-page-contact-actions {
        width: 100%;
        justify-content: center;
        margin-left: 0;
        gap: 1rem;
    }

    .contatos-page-contact-details {
        flex-direction: column;
        align-items: flex-start;
        gap: 0.625rem;
    }

        .contatos-page-contact-details span {
            width: 100%;
            max-width: 100%;
        }

    .contatos-page-contact-group-header {
        padding: 1rem 1.25rem;
        font-size: 1.05rem;
    }

    }

    @@media (max-width: 480px) {
        .contatos-page-wrapper

    {
        padding: 1rem;
        border-radius: var(--radius-md);
    }

    .contatos-page-tabs-container {
        padding: 0.75rem;
    }

    .contatos-page-tab-button {
        padding: 0.75rem 1.25rem;
        font-size: 0.9rem;
    }

    .contatos-page-contact-card-header {
        padding: 1.5rem 1rem;
    }

    .contatos-page-contact-item {
        padding: 1.25rem 1rem;
    }

    .contatos-page-contact-group-header {
        padding: 0.875rem 1rem;
        font-size: 1rem;
    }

    }
</style>

<div class="contatos-page-wrapper">
    <!-- Tabs -->
    <div class="contatos-page-tabs-container">
        <button class="contatos-page-tab-button contatos-page-tab-success toggle-lista" data-target="#contatosInternos">
            <i class="fas fa-building"></i>
            <span>Internos</span>
        </button>
        <button class="contatos-page-tab-button contatos-page-tab-primary toggle-lista" data-target="#contatosExternos">
            <i class="fas fa-handshake"></i>
            <span>Externos</span>
        </button>
        <button class="contatos-page-tab-button contatos-page-tab-warning toggle-lista" data-target="#contatosProfessores">
            <i class="fas fa-chalkboard-teacher"></i>
            <span>Professores</span>
        </button>
    </div>

    <!-- Contatos Internos -->
    <div class="collapse @(listaSelecionada == "contatosInternos" ? "show" : "")" id="contatosInternos">
        <div class="contatos-page-contact-card">
            <div class="contatos-page-contact-card-header">
                <h5><i class="fas fa-building"></i>Contatos Internos</h5>
                @if (User.IsInRole("Admin"))
                {
                    <a href="/ContatoInterno/Create" class="btn btn-success contatos-page-btn-add">
                        <i class="fa fa-plus"></i> <span>Adicionar</span>
                    </a>
                }
            </div>
            <ul class="contatos-page-contacts-list">
                @if (contatosPorDepartamento.Any())
                {
                    foreach (var grupo in contatosPorDepartamento)
                    {
                        <li class="contatos-page-contact-group-header">
                            <i class="fas fa-folder"></i>@grupo.Key
                        </li>
                        foreach (var contato in grupo)
                        {
                            <li class="contatos-page-contact-item">
                                <div class="contatos-page-contact-info">
                                    <strong>@contato.Nome</strong>
                                    <div class="contatos-page-contact-details">
                                        <span><i class="fas fa-phone"></i> @contato.Telefone</span>
                                        <span><i class="fas fa-hashtag"></i> Ramal: @contato.Ramal</span>
                                        <span><i class="fas fa-envelope"></i> @contato.Email</span>
                                    </div>
                                </div>
                                @if (User.IsInRole("Admin"))
                                {
                                    <div class="contatos-page-contact-actions">
                                        <a href="/ContatoInterno/Edit/@contato.ContatoInternoId" class="contatos-page-btn-action contatos-page-btn-edit" title="Editar">
                                            <i class="bi bi-pencil-square"></i>
                                        </a>
                                        <a href="/ContatoInterno/Delete/@contato.ContatoInternoId" class="contatos-page-btn-action contatos-page-btn-delete" title="Excluir">
                                            <i class="bi bi-trash"></i>
                                        </a>
                                    </div>
                                }
                            </li>
                        }
                    }
                }
                else
                {
                    <li class="contatos-page-empty-state">
                        <i class="fas fa-inbox"></i>
                        <p>Nenhum contato interno cadastrado</p>
                    </li>
                }
            </ul>
        </div>
    </div>

    <!-- Contatos Externos -->
    <div class="collapse @(listaSelecionada == "contatosExternos" ? "show" : "")" id="contatosExternos">
        <div class="contatos-page-contact-card">
            <div class="contatos-page-contact-card-header">
                <h5><i class="fas fa-handshake"></i>Contatos Externos</h5>
                @if (User.IsInRole("Admin"))
                {
                    <a href="/ContatoExterno/Create" class="btn btn-primary contatos-page-btn-add">
                        <i class="fa fa-plus"></i> <span>Adicionar</span>
                    </a>
                }
            </div>
            <ul class="contatos-page-contacts-list">
                @if (contatosExternos.Any())
                {
                    foreach (var contato in contatosExternos)
                    {
                        <li class="contatos-page-contact-item">
                            <div class="contatos-page-contact-info">
                                <strong>@contato.Nome</strong>
                                <div class="contatos-page-contact-details">
                                    <span><i class="fas fa-phone"></i> @contato.Telefone</span>
                                    <span><i class="fas fa-envelope"></i> @contato.Email</span>
                                </div>
                            </div>
                            @if (User.IsInRole("Admin"))
                            {
                                <div class="contatos-page-contact-actions">
                                    <a href="/ContatoExterno/Edit/@contato.ContatoExternoId" class="contatos-page-btn-action contatos-page-btn-edit" title="Editar">
                                        <i class="bi bi-pencil-square"></i>
                                    </a>
                                    <a href="/ContatoExterno/Delete/@contato.ContatoExternoId" class="contatos-page-btn-action contatos-page-btn-delete" title="Excluir">
                                        <i class="bi bi-trash"></i>
                                    </a>
                                </div>
                            }
                        </li>
                    }
                }
                else
                {
                    <li class="contatos-page-empty-state">
                        <i class="fas fa-inbox"></i>
                        <p>Nenhum contato externo cadastrado</p>
                    </li>
                }
            </ul>
        </div>
    </div>

    <!-- Professores -->
    <div class="collapse @(listaSelecionada == "contatosProfessores" ? "show" : "")" id="contatosProfessores">
        <div class="contatos-page-contact-card">
            <div class="contatos-page-contact-card-header">
                <h5><i class="fas fa-chalkboard-teacher"></i>Professores</h5>
                @if (User.IsInRole("Admin"))
                {
                    <a href="/ContatoProfessor/Create" class="btn btn-warning contatos-page-btn-add">
                        <i class="fa fa-plus"></i> <span>Adicionar</span>
                    </a>
                }
            </div>
            <ul class="contatos-page-contacts-list">
                @if (contatosProfessores.Any())
                {
                    foreach (var contato in contatosProfessores)
                    {
                        <li class="contatos-page-contact-item">
                            <div class="contatos-page-contact-info">
                                <strong>@contato.Nome</strong>
                                <div class="contatos-page-contact-details">
                                    <span><i class="fas fa-envelope"></i> @contato.Email</span>
                                </div>
                            </div>
                            @if (User.IsInRole("Admin"))
                            {
                                <div class="contatos-page-contact-actions">
                                    <a href="/ContatoProfessor/Edit/@contato.ContatoProfessorId" class="contatos-page-btn-action contatos-page-btn-edit" title="Editar">
                                        <i class="bi bi-pencil-square"></i>
                                    </a>
                                    <a href="/ContatoProfessor/Delete/@contato.ContatoProfessorId" class="contatos-page-btn-action contatos-page-btn-delete" title="Excluir">
                                        <i class="bi bi-trash"></i>
                                    </a>
                                </div>
                            }
                        </li>
                    }
                }
                else
                {
                    <li class="contatos-page-empty-state">
                        <i class="fas fa-inbox"></i>
                        <p>Nenhum professor cadastrado</p>
                    </li>
                }
            </ul>
        </div>
    </div>
</div>

<script>
    window.initAccordion = function() {
        document.querySelectorAll('.contatos-page-tab-button.toggle-lista').forEach(function(btn) {
            btn.onclick = function() {
                var target = btn.getAttribute('data-target').replace('#', '');
                window.listaAberta = target;
                ['contatosInternos', 'contatosExternos', 'contatosProfessores'].forEach(function(id) {
                    var el = document.getElementById(id);
                    if (el) {
                        if (id === target) {
                            el.classList.add('show');
                        } else {
                            el.classList.remove('show');
                        }
                    }
                });
            };
        });
    }
    window.initAccordion();
</script>
