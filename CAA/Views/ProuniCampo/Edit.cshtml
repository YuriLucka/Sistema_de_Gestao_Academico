@model CAA.Models.ProuniCampoDocumento
@{
    ViewData["Title"] = "Editar Campo — ProUni";
    Layout = "~/Views/Shared/AdminLTE/_Layout.cshtml";
}

<div class="content-header">
    <div class="container-fluid">
        <h1 class="m-0"><i class="bi bi-pencil-square me-2"></i>Editar Campo de Documento</h1>
    </div>
</div>

<div class="content">
    <div class="container-fluid">
        <div class="card card-outline card-primary" style="max-width:640px;">
            <div class="card-header">
                <h3 class="card-title">@Model.Nome</h3>
            </div>
            <div class="card-body">
                <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" />
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                    <div class="mb-3">
                        <label asp-for="Nome" class="form-label fw-semibold"></label>
                        <input asp-for="Nome" class="form-control" />
                        <span asp-validation-for="Nome" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Ordem" class="form-label fw-semibold"></label>
                        <input asp-for="Ordem" class="form-control" type="number" min="1" />
                        <span asp-validation-for="Ordem" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <div class="form-check form-switch">
                            <input asp-for="TemFrenteVerso" class="form-check-input" type="checkbox" role="switch" />
                            <label asp-for="TemFrenteVerso" class="form-check-label fw-semibold">Tem Frente e Verso</label>
                        </div>
                    </div>

                    <div class="mb-3">
                        <div class="form-check form-switch">
                            <input asp-for="Obrigatorio" class="form-check-input" type="checkbox" role="switch" />
                            <label asp-for="Obrigatorio" class="form-check-label fw-semibold">Obrigatório</label>
                        </div>
                    </div>

                    <div class="mb-4">
                        <div class="form-check form-switch">
                            <input asp-for="Ativo" class="form-check-input" type="checkbox" role="switch" />
                            <label asp-for="Ativo" class="form-check-label fw-semibold">Ativo</label>
                        </div>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary px-4">
                            <i class="bi bi-check-lg me-1"></i>Salvar Alterações
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
