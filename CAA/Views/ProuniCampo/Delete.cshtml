@model CAA.Models.ProuniCampoDocumento
@{
    ViewData["Title"] = "Excluir Campo — ProUni";
    Layout = "~/Views/Shared/AdminLTE/_Layout.cshtml";
}

<div class="content-header">
    <div class="container-fluid">
        <h1 class="m-0 text-danger"><i class="bi bi-trash me-2"></i>Excluir Campo de Documento</h1>
    </div>
</div>

<div class="content">
    <div class="container-fluid">
        <div class="card card-outline card-danger" style="max-width:560px;">
            <div class="card-header">
                <h3 class="card-title">Confirmar Exclusão</h3>
            </div>
            <div class="card-body">
                <div class="alert alert-warning d-flex gap-2">
                    <i class="bi bi-exclamation-triangle-fill fs-5 flex-shrink-0"></i>
                    <div>
                        <strong>Atenção:</strong> Esta ação irá excluir o campo e todos os documentos vinculados a ele nas submissões existentes.
                    </div>
                </div>

                <dl class="row mb-0">
                    <dt class="col-5">Nome:</dt>
                    <dd class="col-7 fw-bold">@Model.Nome</dd>
                    <dt class="col-5">Frente e Verso:</dt>
                    <dd class="col-7">@(Model.TemFrenteVerso ? "Sim" : "Não")</dd>
                    <dt class="col-5">Obrigatório:</dt>
                    <dd class="col-7">@(Model.Obrigatorio ? "Sim" : "Não")</dd>
                    <dt class="col-5">Docs vinculados:</dt>
                    <dd class="col-7">@Model.Documentos.Count</dd>
                </dl>
            </div>
            <div class="card-footer d-flex gap-2">
                <form asp-action="Delete" asp-route-id="@Model.Id" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-danger px-4">
                        <i class="bi bi-trash me-1"></i>Excluir
                    </button>
                </form>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
            </div>
        </div>
    </div>
</div>
