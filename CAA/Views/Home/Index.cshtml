@{
    ViewData["Title"] = "Home";
}

<!-- CDN Libraries -->
<link rel="stylesheet" href="https://unpkg.com/aos@2.3.1/dist/aos.css" />

<style>
    :root {
        --caa-green-main: #25D366;
        --caa-green-dark: #128C7E;
        --caa-green-light: rgba(37, 211, 102, 0.1);
    }

    /* Background simplificado (substitui o particles.js) */
    body {
        background: linear-gradient(135deg, #f8fffe 0%, #f0fdf8 100%);
        min-height: 100vh;
    }

    /* Hero Section */
    .hero-section {
        background: linear-gradient(135deg, rgba(37, 211, 102, 0.08) 0%, rgba(18, 140, 126, 0.05) 100%);
        border-radius: 30px;
        padding: 4rem 2rem 2rem 2rem;
        margin-bottom: 1rem;
        border: 2px solid rgba(37, 211, 102, 0.2);
        text-align: center;
        position: relative;
        overflow: hidden;
        backdrop-filter: blur(10px);
        box-shadow: 0 10px 40px rgba(0, 0, 0, 0.08);
        /* Removido hero-float para deixar mais estático/leve se desejar, ou mantenha se gostar do balanço */
        animation: hero-float 6s ease-in-out infinite;
    }

    @@keyframes hero-float {
        0%, 100% {
            transform: translateY(0);
        }

        50% {
            transform: translateY(-10px);
        }
    }

    .hero-section::before {
        content: '';
        position: absolute;
        top: -50%;
        right: -10%;
        width: 600px;
        height: 600px;
        background: radial-gradient(circle, rgba(37, 211, 102, 0.15) 0%, transparent 70%);
        border-radius: 50%;
        animation: pulse-glow 4s ease-in-out infinite;
    }

    .hero-section::after {
        content: '';
        position: absolute;
        bottom: -30%;
        left: -10%;
        width: 500px;
        height: 500px;
        background: radial-gradient(circle, rgba(18, 140, 126, 0.1) 0%, transparent 70%);
        border-radius: 50%;
        animation: pulse-glow 5s ease-in-out infinite reverse;
    }

    @@keyframes pulse-glow {
        0%, 100% {
            transform: scale(1);
            opacity: 0.6;
        }

        50% {
            transform: scale(1.1);
            opacity: 0.8;
        }
    }

    .hero-content {
        position: relative;
        z-index: 1;
    }

    .hero-logo {
        max-width: 240px;
        margin-bottom: 2rem;
        filter: drop-shadow(0 8px 16px rgba(0, 0, 0, 0.15));
        animation: logo-entrance 1.2s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
        opacity: 0;
    }

    @@keyframes logo-entrance {
        from {
            opacity: 0;
            transform: scale(0.8);
        }

        to {
            opacity: 1;
            transform: scale(1);
        }
    }

    .hero-title {
        font-size: 2.2rem;
        font-weight: 700;
        background: linear-gradient(90deg, var(--caa-green-dark), var(--caa-green-main), var(--caa-green-dark));
        background-size: 200% auto;
        -webkit-background-clip: text;
        background-clip: text;
        -webkit-text-fill-color: transparent;
        margin-bottom: 1.5rem;
        line-height: 1.3;
        animation: gradient-shift 3s ease infinite, title-fade-in 1s ease 0.3s forwards;
        opacity: 0;
    }

    @@keyframes gradient-shift {
        0%, 100% {
            background-position: 0% center;
        }

        50% {
            background-position: 100% center;
        }
    }

    @@keyframes title-fade-in {
        from {
            opacity: 0;
            transform: translateY(20px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .hero-scroll-arrow {
        display: block;
        font-size: 2.5rem;
        color: var(--caa-green-main);
        cursor: pointer;
        animation: bounceDown 2.5s infinite;
        opacity: 0.8;
        transition: color 0.3s;
    }

        .hero-scroll-arrow:hover {
            color: var(--caa-green-dark);
        }

    @@keyframes bounceDown {
        0%, 100% {
            transform: translateY(0);
            opacity: 0.8;
        }

        50% {
            transform: translateY(10px);
            opacity: 1;
        }
    }

    .hero-description {
        font-size: 1.05rem;
        line-height: 1.7;
        max-width: 700px;
        margin: 0 auto;
        animation: description-fade-in 1s ease 0.6s forwards;
        opacity: 0;
    }

    @@keyframes description-fade-in {
        from {
            opacity: 0;
            transform: translateY(20px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* Section Title */
    .section-title {
        text-align: center;
        margin-bottom: 3rem;
    }

        .section-title h2 {
            font-size: 1.9rem;
            font-weight: 700;
            color: var(--caa-green-dark);
            margin-bottom: 0.75rem;
        }

        .section-title p {
            font-size: 1.05rem;
            color: #6b7280;
        }

    /* Module Cards Grid */
    .modules-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
        gap: 2rem;
        margin-bottom: 3rem;
        /* Removido perspective para tirar o efeito 3D */
    }

    /* Card Animations Simplificadas */
    .module-card {
        background: rgba(255, 255, 255, 0.95);
        backdrop-filter: blur(10px);
        border-radius: 24px;
        padding: 2.5rem 2rem;
        text-align: center;
        transition: all 0.3s ease; /* Transição mais rápida e simples */
        cursor: pointer;
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.08);
        border: 2px solid transparent;
        min-height: 300px;
        display: flex;
        flex-direction: column;
        position: relative;
        overflow: hidden;
        /* Removido transform-style 3d */
    }

        /* Efeito de Borda com Gradiente mantido */
        .module-card::after {
            content: '';
            position: absolute;
            inset: 0;
            border-radius: 24px;
            padding: 2px;
            background: linear-gradient(135deg, transparent, var(--caa-green-main), transparent );
            -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
            -webkit-mask-composite: xor;
            mask-composite: exclude;
            opacity: 0;
            transition: opacity 0.4s;
        }

        .module-card:hover::after {
            opacity: 1;
        }

        /* Hover Effect Simplificado (apenas sobe, sem rotacionar) */
        .module-card:hover {
            transform: translateY(-10px); /* Movimento vertical limpo */
            box-shadow: 0 20px 40px rgba(37, 211, 102, 0.15); /* Sombra mais suave */
            border-color: rgba(37, 211, 102, 0.3);
        }

    /* Icon Container */
    .module-icon {
        width: 80px;
        height: 80px;
        margin: 0 auto 1.5rem;
        border-radius: 20px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 2.2rem;
        transition: all 0.4s ease;
        position: relative;
    }

        /* Camada de fundo do ícone */
        .module-icon::before {
            content: '';
            position: absolute;
            inset: -5px;
            border-radius: 20px;
            background: inherit;
            opacity: 0.4;
            filter: blur(10px);
            /* Removido transform 3D */
        }

    .module-card:hover .module-icon {
        transform: scale(1.1); /* Apenas aumenta levemente */
    }

    .module-icon i {
        transition: all 0.4s ease;
        display: inline-block;
        position: relative;
        z-index: 1;
        filter: drop-shadow(0 4px 8px rgba(0, 0, 0, 0.1));
    }

    /* Cores e Gradientes mantidos */
    .icon-primary {
        background: linear-gradient(135deg, rgba(59, 130, 246, 0.15), rgba(99, 102, 241, 0.1));
        color: #3b82f6;
    }

    .module-card:hover .icon-primary {
        background: linear-gradient(135deg, rgba(59, 130, 246, 0.3), rgba(99, 102, 241, 0.2));
    }

    .icon-success {
        background: linear-gradient(135deg, rgba(34, 197, 94, 0.15), rgba(16, 185, 129, 0.1));
        color: #22c55e;
    }

    .module-card:hover .icon-success {
        background: linear-gradient(135deg, rgba(34, 197, 94, 0.3), rgba(16, 185, 129, 0.2));
    }

    .icon-danger {
        background: linear-gradient(135deg, rgba(239, 68, 68, 0.15), rgba(220, 38, 38, 0.1));
        color: #ef4444;
    }

    .module-card:hover .icon-danger {
        background: linear-gradient(135deg, rgba(239, 68, 68, 0.3), rgba(220, 38, 38, 0.2));
    }

    .icon-warning {
        background: linear-gradient(135deg, rgba(251, 191, 36, 0.15), rgba(245, 158, 11, 0.1));
        color: #f59e0b;
    }

    .module-card:hover .icon-warning {
        background: linear-gradient(135deg, rgba(251, 191, 36, 0.3), rgba(245, 158, 11, 0.2));
    }

    .icon-info {
        background: linear-gradient(135deg, rgba(14, 165, 233, 0.15), rgba(6, 182, 212, 0.1));
        color: #0ea5e9;
    }

    .module-card:hover .icon-info {
        background: linear-gradient(135deg, rgba(14, 165, 233, 0.3), rgba(6, 182, 212, 0.2));
    }

    .icon-secondary {
        background: linear-gradient(135deg, rgba(107, 114, 128, 0.15), rgba(75, 85, 99, 0.1));
        color: #6b7280;
    }

    .module-card:hover .icon-secondary {
        background: linear-gradient(135deg, rgba(107, 114, 128, 0.3), rgba(75, 85, 99, 0.2));
    }

    .icon-purple {
        background: linear-gradient(135deg, rgba(168, 85, 247, 0.15), rgba(147, 51, 234, 0.1));
        color: #a855f7;
    }

    .module-card:hover .icon-purple {
        background: linear-gradient(135deg, rgba(168, 85, 247, 0.3), rgba(147, 51, 234, 0.2));
    }

    .icon-pink {
        background: linear-gradient(135deg, rgba(236, 72, 153, 0.15), rgba(219, 39, 119, 0.1));
        color: #ec4899;
    }

    .module-card:hover .icon-pink {
        background: linear-gradient(135deg, rgba(236, 72, 153, 0.3), rgba(219, 39, 119, 0.2));
    }

    .icon-teal {
        background: linear-gradient(135deg, rgba(20, 184, 166, 0.15), rgba(13, 148, 136, 0.1));
        color: #14b8a6;
    }

    .module-card:hover .icon-teal {
        background: linear-gradient(135deg, rgba(20, 184, 166, 0.3), rgba(13, 148, 136, 0.2));
    }

    .icon-orange {
        background: linear-gradient(135deg, rgba(249, 115, 22, 0.15), rgba(234, 88, 12, 0.1));
        color: #f97316;
    }

    .module-card:hover .icon-orange {
        background: linear-gradient(135deg, rgba(249, 115, 22, 0.3), rgba(234, 88, 12, 0.2));
    }

    /* Title */
    .module-title {
        font-size: 1.15rem;
        font-weight: 700;
        margin-bottom: 1rem;
        line-height: 1.4;
        color: #1f2937;
        transition: color 0.3s;
    }

    /* Description */
    .module-description {
        font-size: 0.95rem;
        color: #6b7280;
        line-height: 1.6;
        flex: 1;
    }

    /* Responsive */
    @@media (max-width: 768px) {
        .hero-title {
            font-size: 1.6rem;
        }

        .hero-description {
            font-size: 0.95rem;
        }

        .modules-grid {
            grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
            gap: 1.5rem;
        }

        .module-card {
            padding: 2rem 1.5rem;
            min-height: 280px;
        }
    }
</style>

<!-- Particles Background REMOVIDO -->

<div class="container-fluid py-4">
    <!-- Hero Section -->
    <div class="hero-section">
        <div class="hero-content">
            <img src="/img/marca_uam_campus_athon.png" alt="Logo CAA" class="hero-logo" />
            <h1 class="hero-title">Sistema de Gestão Educacional<br>Central de Atendimento ao Aluno</h1>
            <p class="hero-description">
                Solução completa para gestão acadêmica, administrativa e de atendimento ao aluno.
                Centralize processos essenciais com agilidade, organização, segurança e eficiência.
            </p>
            <i class="bi bi-chevron-double-down hero-scroll-arrow"></i>
        </div>
    </div>

    <!-- Section Title -->
    <div class="section-title">
        <h2>Funcionalidades do Sistema</h2>
        <p>Acesse os recursos disponíveis de acordo com suas permissões</p>
    </div>

    <!-- Modules Grid -->
    <div class="modules-grid">

        <!-- Contatos -->
        <div class="module-card" onclick="location.href='@Url.Action("Index", "Contato")'">
            <div class="module-icon icon-teal">
                <i class="bi bi-telephone-forward-fill"></i>
            </div>
            <h3 class="module-title">Central de Contatos</h3>
            <p class="module-description">
                Cadastro e pesquisa de contatos de setores, professores e parceiros.
            </p>
        </div>

        <!-- Chat -->
        <div class="module-card" onclick="location.href='@Url.Action("Index", "Chat")'">
            <div class="module-icon icon-pink">
                <i class="bi bi-chat-dots-fill"></i>
            </div>
            <h3 class="module-title">Chat de Bate-Papo</h3>
            <p class="module-description">
                Converse em tempo real com outros usuários.
            </p>
        </div>

        <!-- Colaboradores -->
        <div class="module-card" onclick="location.href='@Url.Action("Index", "Colaborador")'">
            <div class="module-icon icon-success">
                <i class="bi bi-person-badge-fill"></i>
            </div>
            <h3 class="module-title">Colaboradores & Permissões</h3>
            <p class="module-description">
                Gestão de colaboradores, controle de permissões e acesso seguro às funcionalidades do sistema.
            </p>
        </div>

        <!-- Configurações -->
        <div class="module-card" onclick="location.href='@Url.Action("Index", "Parametros")'">
            <div class="module-icon icon-secondary">
                <i class="bi bi-gear-fill"></i>
            </div>
            <h3 class="module-title">Configurações</h3>
            <p class="module-description">
                Parâmetros gerais do sistema, personalizações e ajustes de segurança.
            </p>
        </div>

        <!-- Cursos -->
        <div class="module-card" onclick="location.href='@Url.Action("Index", "Curso")'">
            <div class="module-icon icon-primary">
                <i class="bi bi-journal-bookmark-fill"></i>
            </div>
            <h3 class="module-title">Gerenciamento de Cursos</h3>
            <p class="module-description">
                Cadastro completo de cursos, múltiplos planos de pagamento e geração de formulários consolidados.
            </p>
        </div>

        <!-- Documentos -->
        <div class="module-card" onclick="location.href='@Url.Action("Index", "Documento")'">
            <div class="module-icon icon-orange">
                <i class="bi bi-folder2-open"></i>
            </div>
            <h3 class="module-title">Documentos Institucionais</h3>
            <p class="module-description">
                Gerenciamento, organização e download de documentos acadêmicos e administrativos.
            </p>
        </div>

        <!-- Ficha Médica -->
        <div class="module-card" onclick="location.href='@Url.Action("Index", "FichaMedica")'">
            <div class="module-icon icon-danger">
                <i class="bi bi-file-earmark-medical-fill"></i>
            </div>
            <h3 class="module-title">Ficha Médica</h3>
            <p class="module-description">
                Formulários interativos, histórico médico completo dos alunos.
            </p>
        </div>

        <!-- Estágios -->
        <div class="module-card" onclick="location.href='@Url.Action("Index", "Estagio")'">
            <div class="module-icon icon-warning">
                <i class="bi bi-briefcase-fill"></i>
            </div>
            <h3 class="module-title">Gestão de Estágios</h3>
            <p class="module-description">
                Registro e acompanhamento de estágios, contratos e conformidade com normas do MEC.
            </p>
        </div>

        <!-- Links -->
        <div class="module-card" onclick="location.href='@Url.Action("Index", "Link")'">
            <div class="module-icon icon-success">
                <i class="bi bi-link-45deg"></i>
            </div>
            <h3 class="module-title">Links de Acesso Rápido</h3>
            <p class="module-description">
                Centralização e organização de links úteis para colaboradores e gestores.
            </p>
        </div>

        <!-- Matrículas -->
        <div class="module-card" onclick="location.href='@Url.Action("Index", "Matricula")'">
            <div class="module-icon icon-info">
                <i class="bi bi-person-lines-fill"></i>
            </div>
            <h3 class="module-title">Matrículas</h3>
            <p class="module-description">
                Gestão completa de matrículas.
            </p>
        </div>
    </div>
</div>

<!-- Scripts -->
<!-- REMOVIDO: particles.js -->

<script>
    // Scroll to section on hero-scroll-arrow click
    const arrow = document.querySelector('.hero-scroll-arrow');
    if(arrow) {
        arrow.addEventListener('click', () => {
            const nextSection = document.querySelector('.section-title');
            if (nextSection) {
                nextSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
            }
        });
    }
</script>
