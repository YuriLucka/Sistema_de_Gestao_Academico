<!--begin::Sidebar-->
<aside class="app-sidebar shadow" data-bs-theme="dark">
    <!--begin::Sidebar Brand-->
    <div class="sidebar-brand">
        <!--begin::Brand Link-->
        <a href="/" class="brand-link">
            <img src="/img/marca_uam_campus_athon_branca_horizontal.png" alt="Logo" class="brand-image" style="max-height: 60px;" />
        </a>
        <!--end::Brand Link-->
    </div>
    <!--end::Sidebar Brand-->
    <!--begin::Sidebar Wrapper-->
    <div class="sidebar-wrapper">
        <nav class="mt-2">
            <!--begin::Sidebar Menu-->
            <ul class="nav sidebar-menu flex-column"
                data-lte-toggle="treeview"
                role="menu"
                data-accordion="false">
                <!-- Administração -->
                @if (User.IsInRole("Colaboradores") || User.IsInRole("Parametros") || User.IsInRole("Logs & Auditoria") || User.IsInRole("Admin"))
                {
                    <li class="nav-item">
                        <a href="#" class="nav-link">
                            <i class="nav-icon bi bi-key"></i>
                            <p>
                                Administração
                                <i class="nav-arrow bi bi-chevron-right"></i>
                            </p>
                        </a>
                        <ul class="nav nav-treeview">
                            @if (User.IsInRole("Colaboradores") || User.IsInRole("Admin"))
                            {
                                <li class="nav-item">
                                    <a asp-action="Index" asp-controller="Colaborador" class="nav-link">
                                        <p>Colaboradores</p>
                                    </a>
                                </li>
                            }
                            @if (User.IsInRole("Parametros") || User.IsInRole("Admin"))
                            {
                                <li class="nav-item">
                                    <a asp-action="Index" asp-controller="Parametros" class="nav-link">
                                        <p>Parâmetros</p>
                                    </a>
                                </li>
                            }
                        </ul>
                    </li>
                }
                <!-- Atendimento -->
                @if (User.IsInRole("Central de Contatos") || User.IsInRole("Fichas Médicas") || User.IsInRole("Agendas & Calendários") || User.IsInRole("Recados") || User.IsInRole("Admin"))
                {
                    <li class="nav-item">
                        <a href="#" class="nav-link">
                            <i class="nav-icon bi bi-people"></i>
                            <p>
                                Atendimento
                                <i class="nav-arrow bi bi-chevron-right"></i>
                            </p>
                        </a>
                        <ul class="nav nav-treeview">
                            @if (User.IsInRole("Recados") || User.IsInRole("Admin"))
                            {
                                <li class="nav-item">
                                    <a asp-action="Index" asp-controller="Chat" class="nav-link">
                                        <p>Chat</p>
                                    </a>
                                </li>
                            }
                            @if (User.IsInRole("Fichas Médicas") || User.IsInRole("Admin"))
                            {
                                <li class="nav-item">
                                    <a asp-action="Index" asp-controller="FichaMedica" class="nav-link">
                                        <p>Fichas Médicas</p>
                                    </a>
                                </li>
                            }
                            @if (User.IsInRole("Central de Contatos") || User.IsInRole("Admin"))
                            {
                                <li class="nav-item">
                                    <a asp-action="Index" asp-controller="Contato" class="nav-link">
                                        <p>Contatos</p>
                                    </a>
                                </li>
                            }
                        </ul>
                    </li>
                }
                <!-- Acadêmico -->
                @if (User.IsInRole("Cursos") || User.IsInRole("Documentos Institucionais") || User.IsInRole("Matrículas") || User.IsInRole("Estágios") || User.IsInRole("Admin"))
                {
                    <li class="nav-item">
                        <a href="#" class="nav-link">
                            <i class="nav-icon bi bi-journal-bookmark"></i>
                            <p>
                                Acadêmico
                                <i class="nav-arrow bi bi-chevron-right"></i>
                            </p>
                        </a>
                        <ul class="nav nav-treeview">
                            @if (User.IsInRole("Cursos") || User.IsInRole("Admin"))
                            {
                                <li class="nav-item">
                                    <a asp-action="Index" asp-controller="Curso" class="nav-link">
                                        <p>Cursos</p>
                                    </a>
                                </li>
                            }
                            @if (User.IsInRole("Matrículas") || User.IsInRole("Admin"))
                            {
                                <li class="nav-item">
                                    <a asp-action="Index" asp-controller="Matricula" class="nav-link">
                                        <p>Matrículas</p>
                                    </a>
                                </li>
                            }
                            @if (User.IsInRole("Estágios") || User.IsInRole("Admin"))
                            {
                                <li class="nav-item">
                                    <a asp-action="Index" asp-controller="Estagio" class="nav-link">
                                        <p>Estágios</p>
                                    </a>
                                </li>
                            }
                            @if (User.IsInRole("Documentos Institucionais") || User.IsInRole("Admin"))
                            {
                                <li class="nav-item">
                                    <a asp-action="Index" asp-controller="Documento" class="nav-link">
                                        <p>Documentos</p>
                                    </a>
                                </li>
                            }
                        </ul>
                    </li>
                }
                <!-- Links Úteis -->
                @if (User.IsInRole("Links Úteis") || User.IsInRole("Admin"))
                {
                    <li class="nav-item">
                        <a asp-action="Index" asp-controller="Link" class="nav-link">
                            <i class="nav-icon bi bi-link-45deg"></i>
                            <p>
                                Links Úteis
                            </p>
                        </a>
                    </li>
                }
            </ul>
            <!--end::Sidebar Menu-->
        </nav>
    </div>
    <!--end::Sidebar Wrapper-->
</aside>
<!--end::Sidebar-->

<style>
    :root {
        --caa-sb-dark: #064e44;
        --caa-sb-primary: #075e54;
        --caa-sb-accent: #25D366;
        --caa-sb-accent-light: #34e87e;
        --caa-sb-hover: rgba(37, 211, 102, 0.15);
        --caa-sb-active: rgba(37, 211, 102, 0.25);
    }

    /* Sidebar Container com gradiente e efeitos */
    .app-sidebar {
        background: linear-gradient(180deg, var(--caa-sb-dark) 0%, var(--caa-sb-primary) 100%);
        color: white;
        width: 260px;
        display: flex;
        flex-direction: column;
        height: 100vh;
        position: fixed;
        z-index: 1050;
        font-family: 'Inter', 'Segoe UI', system-ui, -apple-system, sans-serif;
        box-shadow: 4px 0 20px rgba(0, 0, 0, 0.2), 0 0 40px rgba(37, 211, 102, 0.1);
        border-right: 1px solid rgba(37, 211, 102, 0.2);
        overflow: hidden;
    }

        /* Efeito de fundo animado sutil */
        .app-sidebar::before {
            content: '';
            position: absolute;
            top: -50%;
            right: -50%;
            width: 200%;
            height: 200%;
            background: radial-gradient(circle, rgba(37, 211, 102, 0.06) 0%, transparent 60%);
            pointer-events: none;
            animation: caa-sb-glow 12s ease-in-out infinite;
        }

    @@keyframes caa-sb-glow {
        0%, 100%

    {
        opacity: 0.4;
        transform: scale(1) rotate(0deg);
    }

    50% {
        opacity: 0.7;
        transform: scale(1.15) rotate(180deg);
    }

    }

    /* Brand area com glassmorphism */
    .app-sidebar .sidebar-brand {
        padding: 1.75rem 1.5rem;
        border-bottom: 1px solid rgba(37, 211, 102, 0.2);
        text-align: center;
        position: relative;
        z-index: 2;
        background: rgba(6, 78, 68, 0.6);
        backdrop-filter: blur(10px);
        -webkit-backdrop-filter: blur(10px);
    }

    .app-sidebar .brand-link {
        display: inline-block;
        transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    }

        .app-sidebar .brand-link:hover {
            transform: scale(1.05) translateY(-2px);
        }

        .app-sidebar .brand-link img.brand-image {
            max-height: 60px;
            object-fit: contain;
            filter: drop-shadow(0 4px 10px rgba(37, 211, 102, 0.25));
            transition: filter 0.3s ease;
        }

        .app-sidebar .brand-link:hover img.brand-image {
            filter: drop-shadow(0 6px 16px rgba(37, 211, 102, 0.4));
        }

    /* Sidebar content wrapper */
    .app-sidebar .sidebar-wrapper {
        overflow-y: auto;
        overflow-x: hidden;
        flex: 1 1 auto;
        padding: 1.25rem 0;
        position: relative;
        z-index: 2;
    }

        /* Scrollbar estilizada */
        .app-sidebar .sidebar-wrapper::-webkit-scrollbar {
            width: 6px;
        }

        .app-sidebar .sidebar-wrapper::-webkit-scrollbar-thumb {
            background: linear-gradient(180deg, var(--caa-sb-accent), var(--caa-sb-accent-light));
            border-radius: 10px;
            transition: background 0.3s ease;
        }

            .app-sidebar .sidebar-wrapper::-webkit-scrollbar-thumb:hover {
                background: var(--caa-sb-accent-light);
            }

        .app-sidebar .sidebar-wrapper::-webkit-scrollbar-track {
            background-color: rgba(0, 0, 0, 0.1);
            border-radius: 10px;
        }

    /* Sidebar Menu */
    .app-sidebar .sidebar-menu {
        list-style: none;
        margin: 0;
        padding: 0 0.75rem;
        display: flex;
        flex-direction: column;
        gap: 0.375rem;
    }

    /* Nav Items */
    .app-sidebar .nav-item {
        width: 100%;
    }

    /* Nav Links com efeitos modernos */
    .app-sidebar .nav-link {
        display: flex;
        align-items: center;
        gap: 0.875rem;
        padding: 0.875rem 1.25rem;
        font-weight: 600;
        font-size: 0.95rem;
        color: rgba(255, 255, 255, 0.88);
        border-radius: 12px;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        cursor: pointer;
        text-decoration: none;
        user-select: none;
        position: relative;
        overflow: hidden;
        letter-spacing: 0.02em;
    }

        /* Efeito de brilho deslizante */
        .app-sidebar .nav-link::before {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 100%;
            height: 100%;
            background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.12), transparent);
            transition: left 0.6s ease;
        }

        .app-sidebar .nav-link:hover::before {
            left: 100%;
        }

        /* Borda lateral animada */
        .app-sidebar .nav-link::after {
            content: '';
            position: absolute;
            left: 0;
            top: 0;
            bottom: 0;
            width: 0;
            background: var(--caa-sb-accent);
            transition: width 0.3s ease;
            border-radius: 0 4px 4px 0;
        }

        .app-sidebar .nav-link:hover::after,
        .app-sidebar .nav-link.active::after {
            width: 4px;
        }

        .app-sidebar .nav-link:hover,
        .app-sidebar .nav-link.active {
            background: var(--caa-sb-hover);
            color: white;
            transform: translateX(4px);
            box-shadow: 0 4px 12px rgba(37, 211, 102, 0.15);
        }

        .app-sidebar .nav-link.active {
            background: var(--caa-sb-active);
        }

        .app-sidebar .nav-link p {
            margin: 0;
            flex: 1;
            display: flex;
            align-items: center;
            justify-content: space-between;
            position: relative;
            z-index: 1;
        }

    /* Nav Icons com efeito de glow */
    .app-sidebar .nav-icon {
        font-size: 1.35rem;
        color: var(--caa-sb-accent);
        flex-shrink: 0;
        filter: drop-shadow(0 2px 8px rgba(37, 211, 102, 0.5)); /* brilho mais visível */
        transition: all 0.3s ease;
        position: relative;
        z-index: 1;
    }

    .app-sidebar .nav-link:hover .nav-icon {
        transform: scale(1.15) rotate(8deg);
        filter: drop-shadow(0 4px 16px rgba(37, 211, 102, 0.7));
    }

    /* Arrow icons - rotação perfeita no eixo */
    .app-sidebar .nav-arrow {
        font-size: 0.875rem;
        transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        color: rgba(255, 255, 255, 0.6);
        width: 1em;
        height: 1em;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .app-sidebar .nav-item.menu-open > .nav-link > .nav-arrow {
        transform: rotate(90deg);
        color: var(--caa-sb-accent);
    }

    /* Treeview submenus com animação */
    .app-sidebar .nav-treeview {
        list-style: none;
        margin: 0.5rem 0 0 0;
        padding: 0 0 0 0.75rem;
        display: none;
        flex-direction: column;
        gap: 0.25rem;
        border-left: 2px solid rgba(37, 211, 102, 0.25);
        margin-left: 2rem;
    }

    .app-sidebar .nav-item.menu-open > .nav-treeview {
        display: flex;
        animation: caa-sb-slideDown 0.35s cubic-bezier(0.4, 0, 0.2, 1);
    }

    @@keyframes caa-sb-slideDown {
        from

    {
        opacity: 0;
        transform: translateY(-12px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }

    }

    /* Treeview items */
    .app-sidebar .nav-treeview .nav-item {
        width: 100%;
    }

    /* Treeview links com indicador */
    .app-sidebar .nav-treeview .nav-link {
        font-weight: 500;
        font-size: 0.9rem;
        padding: 0.7rem 1rem 0.7rem 2rem;
        border-radius: 8px;
        color: rgba(255, 255, 255, 0.75);
        position: relative;
    }

        /* Bullet point animado */
        .app-sidebar .nav-treeview .nav-link::before {
            content: '';
            position: absolute;
            left: 0.75rem;
            top: 50%;
            transform: translateY(-50%);
            width: 6px;
            height: 6px;
            background: var(--caa-sb-accent);
            border-radius: 50%;
            opacity: 0.5;
            transition: all 0.3s ease;
        }

        .app-sidebar .nav-treeview .nav-link:hover::before,
        .app-sidebar .nav-treeview .nav-link.active::before {
            opacity: 1;
            transform: translateY(-50%) scale(1.5);
            box-shadow: 0 0 8px var(--caa-sb-accent);
        }

        .app-sidebar .nav-treeview .nav-link:hover,
        .app-sidebar .nav-treeview .nav-link.active {
            background: var(--caa-sb-hover);
            color: white;
            transform: translateX(6px);
        }

        .app-sidebar .nav-treeview .nav-link.active {
            background: var(--caa-sb-active);
            font-weight: 600;
        }

    /* Responsive for smaller screens */
    @@media (max-width: 992px) {
        .app-sidebar

    {
        position: relative;
        width: 100%;
        height: auto;
        display: block;
    }

    .app-sidebar .sidebar-wrapper {
        max-height: 500px;
    }

    }

    @@media (max-width: 768px) {
        .app-sidebar

    {
        border-right: none;
        border-bottom: 1px solid rgba(37, 211, 102, 0.2);
    }

    .app-sidebar .sidebar-menu {
        padding: 0 1rem;
    }

    .app-sidebar .nav-link {
        padding: 0.75rem 1rem;
        font-size: 0.9rem;
    }

    .app-sidebar .nav-icon {
        font-size: 1.2rem;
    }

    }
</style>
