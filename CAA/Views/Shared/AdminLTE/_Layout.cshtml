<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <partial name="AdminLTE/_Styles" />
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 48 48'%3E%3Crect width='48' height='48' rx='8' fill='%2300AD8E'/%3E%3Ctext x='24' y='32' text-anchor='middle' font-size='28' font-family='Arial,Helvetica,sans-serif' fill='white' font-weight='bold'%3EA%3C/text%3E%3C/svg%3E" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="sidebar-expanded">
    <partial name="AdminLTE/_MainNavigation" />
    <div id="main-wrapper">
        <partial name="AdminLTE/_TopNavigation" />
        <main id="page-content">
            <div class="container-fluid">
                @RenderBody()
            </div>
        </main>
    </div>
    <partial name="AdminLTE/_Scripts" />
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.5/signalr.min.js"></script>
    <script>
        const connection = new signalR.HubConnectionBuilder()
            .withUrl("/chathub")
            .withAutomaticReconnect()
            .build();

        connection.on("NotificacaoMensagem", function (remetenteUserName, conteudo) {
            if (!window.location.pathname.toLowerCase().includes("/chat")) {
                Swal.fire({
                    toast: true, position: 'top-end', icon: 'info',
                    title: `<b>${remetenteUserName}</b> enviou: ${conteudo}`,
                    showConfirmButton: false, timer: 3000, timerProgressBar: true
                });
            }
        });

        connection.start();
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
