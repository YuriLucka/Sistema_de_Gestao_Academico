<!DOCTYPE html>
<html lang="pt-br">
<head>
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/jquery.dataTables.min.css" />
    <!-- Metadados essenciais para responsividade e codificação -->
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!-- Título dinâmico da página -->
    <title>@ViewData["Title"]</title>
    <meta name="title" content="@ViewData["Title"]" />
    <meta name="author" content="CAA" />
    <!-- Inclusão do CSS principal do site -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="preload" href="~/lib/fontsource/source-sans-3/files/source-sans-3-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin>
    <!-- Inclusão de estilos específicos do AdminLTE -->
    <partial name="AdminLTE/_Styles" />
    <!-- Favicon em SVG personalizado para o sistema -->
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 48 48'%3E%3Crect width='48' height='48' rx='8' fill='%2300AD8E'/%3E%3Ctext x='24' y='32' text-anchor='middle' font-size='28' font-family='Arial, Helvetica, sans-serif' fill='white' font-weight='bold'%3EA%3C/text%3E%3C/svg%3E" />
    <!-- Seção opcional para estilos adicionais das páginas -->
    @await RenderSectionAsync("Styles", required: false)
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
</head>
<body class="layout-fixed sidebar-expand-lg bg-body-tertiary">
    <div class="app-wrapper">
        <!-- Menu lateral de navegação principal -->
        <partial name="AdminLTE/_MainNavigation" />
        <!-- Barra de navegação superior -->
        <partial name="AdminLTE/_TopNavigation" />

        <main class="app-main py-2">
            <!--begin::App Content-->
            <div class="app-content">
                <!--begin::Container-->
                <div class="container-fluid">
                    @RenderBody()
                </div>
                <!--end::Container-->
            </div>
            <!--end::App Content-->
        </main>
        <!-- Rodapé do sistema -->
        <partial name="AdminLTE/_Footer" />
    </div>
    <!-- Inclusão dos scripts JS necessários -->
    <partial name="AdminLTE/_Scripts" />
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.5/signalr.min.js"></script>
    <script>
        const connection = new signalR.HubConnectionBuilder()
           .withUrl("/chathub")
           .withAutomaticReconnect() // ativa reconexão automática
           .build();

            connection.on("NotificacaoMensagem", function(remetenteUserName, conteudo) {
            // Só exibe o toast se NÃO estiver na tela de chat
            if (!window.location.pathname.toLowerCase().includes("/chat")) {
                Swal.fire({
                    toast: true,
                    position: 'top-end',
                    icon: 'info',
                    title: `<b>${remetenteUserName}</b> enviou: ${conteudo}`,
                    showConfirmButton: false,
                    timer: 3000,
                    timerProgressBar: true
                });
            }
        });

         connection.start();
    </script>
    <script>
        document.documentElement.setAttribute("data-bs-theme", "light");
    </script>
    <!-- Seção opcional para scripts adicionais das páginas -->
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
