@{
    ViewData["Title"] = "Parâmetros do Sistema";
}

<style>

    /* Page Header */
    .params-page-header {
        background: linear-gradient(135deg, rgba(37, 211, 102, 0.05) 0%, rgba(18, 140, 126, 0.05) 100%);
        border-radius: 16px;
        padding: 2rem;
        margin-bottom: 2.5rem;
        border: 1px solid rgba(37, 211, 102, 0.2);
        backdrop-filter: blur(10px);
        text-align: center;
    }

        .params-page-header h1 {
            font-size: 2rem;
            font-weight: 700;
            color: var(--caa-green-dark);
            margin-bottom: 0.5rem;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 0.75rem;
        }

            .params-page-header h1 i {
                font-size: 2.5rem;
            }

        .params-page-header p {
            color: #6b7280;
            margin: 0;
            font-size: 1rem;
        }

    /* Category Sections */
    .params-category {
        margin-bottom: 3rem;
    }

    .category-title {
        font-size: 1.3rem;
        font-weight: 700;
        color: var(--caa-green-dark);
        margin-bottom: 1.5rem;
        padding-bottom: 0.75rem;
        border-bottom: 3px solid var(--caa-green-light);
        display: flex;
        align-items: center;
        gap: 0.75rem;
    }

        .category-title i {
            font-size: 1.5rem;
            color: var(--caa-green-main);
        }

    /* Cards Grid */
    .params-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
        gap: 1.5rem;
    }

    /* Parameter Card */
    .param-card {
        background: white;
        border: 2px solid #f3f4f6;
        border-radius: 16px;
        padding: 1.75rem;
        text-decoration: none;
        color: inherit;
        transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        display: flex;
        flex-direction: column;
        gap: 1rem;
        position: relative;
        overflow: hidden;
    }

        .param-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 4px;
            background: linear-gradient(90deg, var(--caa-green-main), var(--caa-green-dark));
            transform: scaleX(0);
            transition: transform 0.3s ease;
        }

        .param-card:hover {
            transform: translateY(-8px);
            border-color: var(--caa-green-main);
            box-shadow: 0 12px 40px rgba(37, 211, 102, 0.15);
        }

            .param-card:hover::before {
                transform: scaleX(1);
            }

    .param-card-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 1rem;
    }

    .param-card-title {
        font-size: 1.1rem;
        font-weight: 700;
        color: #111b21;
        margin: 0;
        line-height: 1.3;
        flex: 1;
    }

    .param-card-icon {
        width: 56px;
        height: 56px;
        background: var(--caa-green-light);
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        transition: all 0.3s ease;
    }

    .param-card:hover .param-card-icon {
        background: var(--caa-green-main);
        transform: rotate(-10deg) scale(1.1);
    }

    .param-card-icon i {
        font-size: 1.75rem;
        color: var(--caa-green-main);
        transition: color 0.3s ease;
    }

    .param-card:hover .param-card-icon i {
        color: white;
    }

    .param-card-description {
        color: #6b7280;
        font-size: 0.9rem;
        line-height: 1.5;
        margin: 0;
    }

    .param-card-footer {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        color: var(--caa-green-dark);
        font-size: 0.85rem;
        font-weight: 600;
        margin-top: auto;
        padding-top: 0.75rem;
        border-top: 1px solid #f3f4f6;
    }

        .param-card-footer i {
            font-size: 1rem;
            transition: transform 0.3s ease;
        }

    .param-card:hover .param-card-footer i {
        transform: translateX(4px);
    }

    /* Empty State */
    .empty-state {
        text-align: center;
        padding: 4rem 2rem;
        color: #6b7280;
    }

        .empty-state i {
            font-size: 4rem;
            color: #d1d7db;
            margin-bottom: 1.5rem;
        }

    /* Responsive */
    @@media (max-width: 768px) {
        .params-page-header h1

    {
        font-size: 1.5rem;
    }

    .params-grid {
        grid-template-columns: 1fr;
    }

    .category-title {
        font-size: 1.1rem;
    }

    }
</style>

<div class="container-fluid px-3">
