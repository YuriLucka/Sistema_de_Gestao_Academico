@model IEnumerable<CAA.Models.Usuario>

@{
    ViewData["Title"] = "Colaboradores";
}

<style>
    :root {
        --caa-green-main: #25D366;
        --caa-green-dark: #128C7E;
        --caa-green-light: rgba(37, 211, 102, 0.1);
    }

    /* Page Header */
    .colaboradores-page-header {
        background: linear-gradient(135deg, var(--caa-green-light) 0%, rgba(18, 140, 126, 0.05) 100%);
        border-radius: 16px;
        padding: 2rem;
        margin-bottom: 2rem;
        border: 1px solid var(--caa-green-light);
        backdrop-filter: blur(10px);
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 1rem;
    }

    .colaboradores-header-content h1 {
        font-size: 1.75rem;
        font-weight: 700;
        color: var(--caa-green-dark);
        margin-bottom: 0.5rem;
        display: flex;
        align-items: center;
        gap: 0.75rem;
    }

        .colaboradores-header-content h1 i {
            font-size: 2rem;
        }

    .colaboradores-header-content p {
        color: #6b7280;
        margin: 0;
        font-size: 0.95rem;
    }

    /* Button Novo Colaborador com efeito c�rculo crescendo */
    .btn-new-colaborador {
        background: linear-gradient(135deg, var(--caa-green-main), var(--caa-green-dark));
        color: white;
        border: none;
        border-radius: 16px;
        padding: 1rem 2rem;
        font-weight: 600;
        font-size: 1rem;
        transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        position: relative;
        overflow: hidden;
        box-shadow: 0 4px 15px rgba(37, 211, 102, 0.2);
        text-decoration: none;
        cursor: pointer;
    }

        .btn-new-colaborador::before {
            content: '';
            position: absolute;
            top: 50%;
            left: 50%;
            width: 0;
            height: 0;
            border-radius: 50%;
            background: rgba(255, 255, 255, 0.3);
            transform: translate(-50%, -50%);
            transition: width 0.6s ease, height 0.6s ease;
            z-index: 0;
        }

        .btn-new-colaborador:hover::before {
            width: 300px;
            height: 300px;
        }

        .btn-new-colaborador:hover {
            transform: translateY(-3px);
            box-shadow: 0 8px 25px rgba(37, 211, 102, 0.35);
            color: white;
            z-index: 1;
        }

        .btn-new-colaborador i,
        .btn-new-colaborador span {
            position: relative;
            z-index: 1;
        }

    /* Table Container */
    .table-container {
        border-radius: 20px;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
        overflow: hidden;
        padding: 2rem;
        background: white;
    }

    /* DataTables Custom Styling */
    .dataTables_wrapper {
        padding: 0 !important;
    }

    .dataTables_length,
    .dataTables_filter {
        margin-bottom: 1.5rem;
    }

        .dataTables_length label,
        .dataTables_filter label {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            font-weight: 600;
            color: var(--caa-green-dark);
        }

        .dataTables_length select,
        .dataTables_filter input {
            border: 2px solid #e5e7eb;
            border-radius: 10px;
            padding: 0.5rem 0.75rem;
            transition: all 0.3s ease;
            font-size: 0.95rem;
        }

            .dataTables_length select:focus,
            .dataTables_filter input:focus {
                border-color: var(--caa-green-main);
                box-shadow: 0 0 0 3px var(--caa-green-light);
                outline: none;
            }

    table.dataTable {
        border-collapse: separate !important;
        border-spacing: 0 0.5rem !important;
        width: 100% !important;
    }

        table.dataTable thead th {
            background: linear-gradient(135deg, var(--caa-green-light) 0%, rgba(18, 140, 126, 0.05) 100%);
            color: var(--caa-green-dark);
            font-weight: 700;
            padding: 1rem 1.5rem;
            border: none;
            font-size: 0.9rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

            table.dataTable thead th:first-child {
                border-radius: 12px 0 0 12px;
            }

            table.dataTable thead th:last-child {
                border-radius: 0 12px 12px 0;
            }

        table.dataTable tbody tr {
            background: white;
            transition: all 0.3s ease;
        }

            table.dataTable tbody tr:hover {
                background: var(--caa-green-light);
                transform: scale(1.01);
                box-shadow: 0 4px 12px rgba(18, 140, 126, 0.15);
            }

        table.dataTable tbody td {
            padding: 1.25rem 1.5rem;
            border: none;
            vertical-align: middle;
            font-size: 0.95rem;
            color: #374151;
        }

        table.dataTable tbody tr td:first-child {
            border-radius: 12px 0 0 12px;
            font-weight: 600;
            color: var(--caa-green-dark);
        }

        table.dataTable tbody tr td:last-child {
            border-radius: 0 12px 12px 0;
        }

    /* Edit Button (amarelo) */
    .btn-edit-table {
        background: linear-gradient(135deg, #fbbf24 0%, #f59e0b 100%);
        color: white;
        border: none;
        border-radius: 10px;
        padding: 0.5rem 0.75rem;
        font-size: 1rem;
        font-weight: 600;
        transition: all 0.3s ease;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        text-decoration: none;
        cursor: pointer;
        min-width: 38px;
        height: 38px;
    }

        .btn-edit-table:hover {
            background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
            transform: translateY(-2px) scale(1.1);
            box-shadow: 0 6px 20px rgba(251, 191, 36, 0.4);
        }

    /* Pagination */
    .dataTables_paginate {
        padding-top: 1.5rem;
    }

        .dataTables_paginate .paginate_button {
            border-radius: 8px;
            padding: 0.5rem 1rem;
            margin: 0 0.25rem;
            border: 2px solid #e5e7eb;
            background: white;
            color: #374151;
            font-weight: 600;
            transition: all 0.3s ease;
        }

            .dataTables_paginate .paginate_button:hover {
                background: var(--caa-green-light);
                border-color: var(--caa-green-main);
                color: var(--caa-green-dark);
            }

            .dataTables_paginate .paginate_button.current {
                background: var(--caa-green-main);
                border-color: var(--caa-green-main);
                color: white;
            }

            .dataTables_paginate .paginate_button.disabled {
                opacity: 0.5;
                cursor: not-allowed;
            }

    /* Info Text */
    .dataTables_info {
        color: #6b7280;
        font-weight: 500;
        padding-top: 1.5rem;
    }

    /* Colaborador Photo */
    .user-photo-container {
        position: relative;
        display: inline-block;
    }

    .user-photo {
        width: 45px;
        height: 45px;
        border-radius: 50%;
        object-fit: cover;
        border: 3px solid #f3f4f6;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
        transition: all 0.3s ease;
    }

        .user-photo:hover {
            transform: scale(1.1);
            border-color: var(--caa-green-main);
        }

    /* Status Badge */
    .status-badge {
        position: absolute;
        bottom: 2px;
        right: 2px;
        width: 14px;
        height: 14px;
        border-radius: 50%;
        border: 2px solid white;
        box-shadow: 0 0 0 1px rgba(0, 0, 0, 0.1);
    }

    /* Pulsing animation for active status */
    @@keyframes pulseActive {
        0% {
            box-shadow: 0 0 0 0 rgba(34, 197, 94, 0.7);
        }

        70% {
            box-shadow: 0 0 0 8px rgba(34, 197, 94, 0);
        }

        100% {
            box-shadow: 0 0 0 0 rgba(34, 197, 94, 0);
        }
    }

    .status-badge.active {
        background: #22c55e;
        animation: pulseActive 2s infinite;
    }

    .status-badge.inactive {
        background: #ef4444;
    }

    /* Esconde a tabela at� o DataTable estar pronto */
    .table-invisible {
        visibility: hidden;
    }

    /* Responsive Adjustments */
    @@media (max-width: 768px) {
        /* Page Header */
        .colaboradores-page-header {
            flex-direction: column;
            align-items: stretch;
            padding: 1.5rem;
        }

        .colaboradores-header-content h1 {
            justify-content: center;
        }

        .btn-new-colaborador {
            width: 100%;
            justify-content: center;
        }
        /* DataTables Controls - Full Width Stacking */
        .dataTables_wrapper .dataTables_filter,
        .dataTables_wrapper .dataTables_length {
            text-align: left !important;
            float: none !important;
            margin-bottom: 1rem;
            width: 100%;
        }
            /* For�a label a ser flex vertical para que o input fique embaixo do texto */
            .dataTables_wrapper .dataTables_length label,
            .dataTables_wrapper .dataTables_filter label {
                display: flex;
                flex-direction: column;
                align-items: flex-start;
                width: 100%;
                gap: 0.5rem;
            }
            /* Inputs ocupando 100% */
            .dataTables_wrapper .dataTables_length select,
            .dataTables_wrapper .dataTables_filter input {
                width: 100% !important;
                margin-left: 0 !important;
                display: block;
                font-size: 1rem; /* Melhor para toque */
                padding: 0.75rem;
            }
        /* Tabela */
        .table-container {
            padding: 1rem;
        }

        table.dataTable tbody td {
            font-size: 0.85rem;
            padding: 1rem 0.75rem;
        }
    }

</style>

<div class="container-fluid px-3">
    <!-- Page Header -->
    <div class="colaboradores-page-header">
        <div class="colaboradores-header-content">
            <h1>
                <i class="bi bi-people-fill"></i>
                <span>Colaboradores</span>
            </h1>
            <p>Gerencie os colaboradores e suas permiss�es</p>
        </div>
        <a href="@Url.Action("Create", "Colaborador")" class="btn-new-colaborador">
            <i class="bi bi-plus-circle"></i>
            <span>Novo Colaborador</span>
        </a>
    </div>

    <!-- Table Container -->
    <div class="table-container">
        <div class="table-responsive">
            <table id="colaboradores" class="table table-hover align-middle nowrap table-invisible" style="width:100%">
                <thead>
                    <tr>
                        <th></th>
                        <th>Nome</th>
                        <th>Sobrenome</th>
                        <th>Departamento</th>
                        <th>Cargo</th>
                        <th style="width:120px">A��o</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Model)
                    {
                        <tr>
                            <td>
                                @{
                                    string fotoSrc = user.FotoPerfil != null
                                    ? $"data:image/png;base64,{Convert.ToBase64String(user.FotoPerfil)}"
                                    : Url.Content("~/img/placeholderPerfil.png");
                                }
                                <div class="user-photo-container">
                                    <img src="@fotoSrc"
                                         alt="@user.Nome"
                                         class="user-photo"
                                         title="@user.Nome @user.Sobrenome" />
                                    <span class="status-badge @(user.Ativo ? "active" : "inactive")"
                                          title="@(user.Ativo ? "Usu�rio ativo" : "Usu�rio inativo")"></span>
                                </div>
                            </td>
                            <td><strong>@user.Nome</strong></td>
                            <td>@user.Sobrenome</td>
                            <td>@user.Departamento</td>
                            <td>@user.Cargo</td>
                            <td>
                                <a href="@Url.Action("Edit", "Colaborador", new { id = user.Id })"
                                   class="btn-edit-table"
                                   title="Editar colaborador">
                                    <i class="bi bi-pencil-square"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/jquery.dataTables.min.css" />
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>

    <script>
        $(document).ready(function () {
            $('#colaboradores').DataTable({
                responsive: true,
                language: {
                    url: '//cdn.datatables.net/plug-ins/1.13.6/i18n/pt-BR.json'
                },
                columnDefs: [
                    { orderable: false, targets: [0, 5] },
                    { className: 'text-center', targets: [0, 5] }
                ],
                order: [[1, 'asc']],
                pageLength: 25,
                dom: '<"row"<"col-sm-12 col-md-6"l><"col-sm-12 col-md-6"f>>rtip',
                initComplete: function () {
                    $('#colaboradores').removeClass('table-invisible');
                }
            });

            // Fade-in animation for table container
            $('.table-container').css({
                'opacity': '0',
                'transform': 'translateY(20px)'
            });
            setTimeout(function () {
                $('.table-container').css({
                    'transition': 'all 0.5s ease',
                    'opacity': '1',
                    'transform': 'translateY(0)'
                });
            }, 100);
        });
    </script>
}
