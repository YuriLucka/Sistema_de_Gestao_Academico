@model IEnumerable<CAA.Models.Empresa>

@{
    ViewData["Title"] = "Empresas";
}

<style>
    :root {
        --caa-green-main: #25D366;
        --caa-green-dark: #128C7E;
        --caa-green-light: rgba(37, 211, 102, 0.1);
    }

    /* Page Header */
    .empresas-page-header {
        background: linear-gradient(135deg, rgba(37, 211, 102, 0.05) 0%, rgba(18, 140, 126, 0.05) 100%);
        border-radius: 16px;
        padding: 2rem;
        margin-bottom: 2rem;
        border: 1px solid rgba(37, 211, 102, 0.2);
        backdrop-filter: blur(10px);
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 1rem;
    }

    .empresas-header-content h1 {
        font-size: 1.75rem;
        font-weight: 700;
        color: var(--caa-green-dark);
        margin-bottom: 0.5rem;
        display: flex;
        align-items: center;
        gap: 0.75rem;
    }

        .empresas-header-content h1 i {
            font-size: 2rem;
        }

    .empresas-header-content p {
        color: #6b7280;
        margin: 0;
        font-size: 0.95rem;
    }

    .btn-new-empresa {
        background: linear-gradient(135deg, var(--caa-green-main), var(--caa-green-dark));
        color: white;
        border: none;
        border-radius: 12px;
        padding: 0.875rem 1.75rem;
        font-weight: 600;
        font-size: 0.95rem;
        transition: all 0.3s ease;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        text-decoration: none;
        box-shadow: 0 4px 15px rgba(37, 211, 102, 0.2);
    }

        .btn-new-empresa:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(37, 211, 102, 0.35);
            color: white;
        }

    /* List Container */
    .empresas-list-container {
        background: white;
        border-radius: 20px;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
        overflow: hidden;
        border: 2px solid #f3f4f6;
    }

    .empresas-list {
        list-style: none;
        padding: 0;
        margin: 0;
    }

    .empresa-item {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 1.5rem 2rem;
        border-bottom: 1px solid #f3f4f6;
        transition: all 0.3s ease;
        gap: 1.5rem;
    }

        .empresa-item:last-child {
            border-bottom: none;
        }

        .empresa-item:hover {
            background: var(--caa-green-light);
        }

    .empresa-content {
        display: flex;
        align-items: center;
        gap: 1.5rem;
        flex: 1;
        min-width: 0;
    }

    .empresa-icon {
        width: 48px;
        height: 48px;
        background: var(--caa-green-light);
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

        .empresa-icon i {
            font-size: 1.5rem;
            color: var(--caa-green-main);
        }

    .empresa-info {
        display: grid;
        grid-template-columns: 2fr 1.5fr 1fr;
        gap: 1.5rem;
        flex: 1;
        min-width: 0;
    }

    .empresa-field {
        min-width: 0;
    }

    .empresa-label {
        font-size: 0.75rem;
        color: #6b7280;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        font-weight: 600;
        margin-bottom: 0.25rem;
    }

    .empresa-value {
        font-size: 0.95rem;
        font-weight: 600;
        color: #111b21;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

        .empresa-value.cnpj {
            font-family: 'Courier New', monospace;
            color: #6b7280;
        }

    .empresa-actions {
        display: flex;
        gap: 0.5rem;
        flex-shrink: 0;
    }

    .btn-action {
        padding: 0.5rem 0.875rem;
        border-radius: 10px;
        border: none;
        font-size: 0.85rem;
        font-weight: 600;
        transition: all 0.3s ease;
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        text-decoration: none;
        cursor: pointer;
    }

    .btn-edit {
        background: rgba(37, 211, 102, 0.1);
        color: var(--caa-green-main);
    }

        .btn-edit:hover {
            background: var(--caa-green-main);
            color: white;
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(37, 211, 102, 0.3);
        }

    .btn-details {
        background: rgba(59, 130, 246, 0.1);
        color: #3b82f6;
    }

        .btn-details:hover {
            background: #3b82f6;
            color: white;
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(59, 130, 246, 0.3);
        }

    .btn-delete {
        background: rgba(239, 68, 68, 0.1);
        color: #ef4444;
    }

        .btn-delete:hover {
            background: #ef4444;
            color: white;
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(239, 68, 68, 0.3);
        }

    /* Empty State */
    .empty-state {
        text-align: center;
        padding: 5rem 2rem;
        color: #6b7280;
    }

        .empty-state i {
            font-size: 5rem;
            color: #d1d7db;
            margin-bottom: 1.5rem;
        }

        .empty-state h3 {
            color: #374151;
            margin-bottom: 0.75rem;
            font-size: 1.5rem;
            font-weight: 700;
        }

        .empty-state p {
            color: #9ca3af;
            font-size: 1rem;
            margin-bottom: 1.5rem;
        }

    /* Responsive */
    @@media (max-width: 1200px) {
        .empresa-info

    {
        grid-template-columns: 1fr;
        gap: 0.75rem;
    }

    .empresa-label {
        display: none;
    }

    }

    @@media (max-width: 768px) {
        .empresas-page-header

    {
        flex-direction: column;
        align-items: stretch;
        text-align: center;
    }

    .empresas-header-content h1 {
        justify-content: center;
    }

    .btn-new-empresa {
        width: 100%;
        justify-content: center;
    }

    .empresa-item {
        flex-direction: column;
        align-items: stretch;
        gap: 1rem;
    }

    .empresa-content {
        flex-direction: column;
    }

    .empresa-info {
        width: 100%;
    }

    .empresa-actions {
        justify-content: center;
        flex-wrap: wrap;
    }

    .btn-action {
        flex: 1;
        min-width: 100px;
        justify-content: center;
    }

    }
</style>

<div class="container-fluid px-3">
    <!-- Page Header -->
    <div class="empresas-page-header">
        <div class="empresas-header-content">
            <h1>
                <i class="bi bi-buildings"></i>
                <span>Empresas</span>
            </h1>
            <p>Gerencie as empresas parceiras para estágios</p>
        </div>
        <a asp-action="Create" class="btn-new-empresa">
            <i class="bi bi-plus-circle"></i>
            <span>Nova Empresa</span>
        </a>
    </div>

    <!-- Empresas List -->
    <div class="empresas-list-container">
        @if (Model != null && Model.Any())
        {
            <ul class="empresas-list">
                @foreach (var empresa in Model)
                {
                    <li class="empresa-item">
                        <div class="empresa-content">
                            <div class="empresa-icon">
                                <i class="bi bi-building-fill"></i>
                            </div>
                            <div class="empresa-info">
                                <div class="empresa-field">
                                    <div class="empresa-label">Razão Social</div>
                                    <div class="empresa-value" title="@empresa.RazaoSocial">
                                        @Html.DisplayFor(modelItem => empresa.RazaoSocial)
                                    </div>
                                </div>
                                <div class="empresa-field">
                                    <div class="empresa-label">Nome Fantasia</div>
                                    <div class="empresa-value" title="@empresa.NomeFantasia">
                                        @Html.DisplayFor(modelItem => empresa.NomeFantasia)
                                    </div>
                                </div>
                                <div class="empresa-field">
                                    <div class="empresa-label">CNPJ</div>
                                    <div class="empresa-value cnpj">
                                        @Html.DisplayFor(modelItem => empresa.CNPJ)
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="empresa-actions">
                            <a asp-action="Edit" asp-route-id="@empresa.EmpresaId" class="btn-action btn-edit" title="Editar">
                                <i class="bi bi-pencil"></i>
                                <span>Editar</span>
                            </a>
                            <a asp-action="Details" asp-route-id="@empresa.EmpresaId" class="btn-action btn-details" title="Detalhes">
                                <i class="bi bi-eye"></i>
                                <span>Ver</span>
                            </a>
                            <a asp-action="Delete" asp-route-id="@empresa.EmpresaId" class="btn-action btn-delete" title="Excluir">
                                <i class="bi bi-trash"></i>
                                <span>Excluir</span>
                            </a>
                        </div>
                    </li>
                }
            </ul>
        }
        else
        {
            <div class="empty-state">
                <i class="bi bi-buildings"></i>
                <h3>Nenhuma empresa cadastrada</h3>
                <p>Cadastre a primeira empresa parceira para estágios</p>
                <a asp-action="Create" class="btn-new-empresa">
                    <i class="bi bi-plus-circle"></i>
                    <span>Cadastrar Primeira Empresa</span>
                </a>
            </div>
        }
    </div>
</div>
